---
import Layout from '../layouts/Layout.astro';

const token = Astro.url.searchParams.get('token') ?? '';

let status: 'form' | 'success' | 'expired' | 'used' | 'invalid' = token ? 'form' : 'invalid';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const formToken = form.get('token')?.toString() ?? '';
  const newPassword = form.get('newPassword')?.toString() ?? '';
  const confirmPassword = form.get('confirmPassword')?.toString() ?? '';

  if (!formToken) {
    status = 'invalid';
  } else if (newPassword !== confirmPassword) {
    error = 'Новий пароль та підтвердження не збігаються';
  } else if (newPassword.length < 8) {
    error = 'Пароль має бути не менше 8 символів';
  } else {
    try {
      const res = await fetch('https://api.litopys.win/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: formToken, newPassword }),
      });
      const data = await res.json();

      if (data.ok) {
        status = 'success';
      } else if (data.error === 'token_expired') {
        status = 'expired';
      } else if (data.error === 'token_already_used') {
        status = 'used';
      } else if (data.error === 'password_too_short') {
        error = 'Пароль має бути не менше 8 символів';
      } else {
        error = data.error ?? 'Помилка скидання паролю';
      }
    } catch {
      error = 'Помилка зʼєднання з сервером';
    }
  }
}
---

<Layout title="Новий пароль — Літопис">
  <div class="wrap">
    <div class="card">
      <img src="/litopys-logo-dark.png" alt="Літопис" class="logo" />

      {status === 'form' && (
        <>
          <h1>Створити новий пароль</h1>
          <p class="sub">Введіть новий пароль для вашого акаунту</p>

          {error && <div class="alert-error">{error}</div>}

          <form method="POST" class="form">
            <input type="hidden" name="token" value={token} />
            <label>
              Новий пароль
              <input type="password" name="newPassword" required autocomplete="new-password" placeholder="Мінімум 8 символів" minlength="8" autofocus />
            </label>
            <label>
              Підтвердження паролю
              <input type="password" name="confirmPassword" required autocomplete="new-password" placeholder="••••••••" minlength="8" />
            </label>
            <button type="submit" class="btn-submit">Зберегти пароль</button>
          </form>
        </>
      )}

      {status === 'success' && (
        <div class="state">
          <div class="icon">✅</div>
          <h1>Пароль змінено</h1>
          <p class="sub">Ваш пароль успішно оновлено. Тепер увійдіть з новим паролем.</p>
          <a href="/login" class="btn">Увійти</a>
        </div>
      )}

      {status === 'expired' && (
        <div class="state">
          <div class="icon">⏰</div>
          <h1>Посилання застаріло</h1>
          <p class="sub">Термін дії посилання минув (1 година). Запросіть нове.</p>
          <a href="/forgot-password" class="btn">Надіслати знову</a>
        </div>
      )}

      {status === 'used' && (
        <div class="state">
          <div class="icon">✅</div>
          <h1>Вже використано</h1>
          <p class="sub">Це посилання вже було використано раніше.</p>
          <a href="/login" class="btn">Увійти</a>
        </div>
      )}

      {status === 'invalid' && (
        <div class="state">
          <div class="icon">❌</div>
          <h1>Невірне посилання</h1>
          <p class="sub">Токен відсутній або недійсний. Запросіть нове посилання для скидання паролю.</p>
          <a href="/forgot-password" class="btn">Відновити пароль</a>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .wrap {
    min-height: calc(100vh - 52px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }
  .card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 2.5rem 2rem;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 8px 32px rgba(0,0,0,.08);
    text-align: center;
  }
  .logo { height: 48px; margin: 0 auto 1.25rem; }
  h1 { font-size: 1.375rem; font-weight: 800; color: #111827; margin-bottom: .375rem; letter-spacing: -.03em; }
  .sub { font-size: .875rem; color: #6b7280; margin-bottom: 1.75rem; }

  .state { display: flex; flex-direction: column; align-items: center; gap: .75rem; }
  .state h1 { margin-bottom: 0; }
  .icon { font-size: 3rem; }
  .state .sub { max-width: 300px; line-height: 1.6; margin-bottom: 0; }
  .btn {
    display: inline-block;
    margin-top: .5rem;
    background: #1a1a2e;
    color: #fff;
    border-radius: 10px;
    padding: .65rem 1.5rem;
    font-size: .9rem;
    font-weight: 700;
    transition: opacity .2s;
  }
  .btn:hover { opacity: .85; }

  .form { display: flex; flex-direction: column; gap: 1rem; text-align: left; }
  label { display: flex; flex-direction: column; gap: .375rem; font-size: .8125rem; font-weight: 600; color: #374151; }
  input {
    padding: .65rem .9rem;
    border: 1.5px solid #d1d5db;
    border-radius: 10px;
    font-size: .9375rem;
    font-family: inherit;
    outline: none;
    transition: border-color .15s;
  }
  input:focus { border-color: #1a1a2e; }
  .btn-submit {
    margin-top: .5rem;
    background: #1a1a2e;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: .75rem;
    font-size: .9375rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .2s;
  }
  .btn-submit:hover { opacity: .85; }
  .alert-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 10px;
    padding: .65rem 1rem;
    font-size: .875rem;
    margin-bottom: 1rem;
    text-align: left;
  }
</style>
