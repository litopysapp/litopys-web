---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ціни — Літопис" description="Вартість Літопису та рукописних шрифтів.">

  <!-- ══ HERO ══ -->
  <section class="hero-page">
    <div class="hero-bg"></div>
    <div class="container">
      <p class="eyebrow fade-up">Ціни</p>
      <h1 class="fade-up" style="--d:.05s">Скільки коштує<br/>Літопис.</h1>
      <p class="hero-sub fade-up" style="--d:.1s">Разова оплата, без підписок і прихованих платежів.</p>
    </div>
  </section>

  <!-- ══ PLANS ══ -->
  <section class="section-plans">
    <div class="container">
      <div class="plans-grid">

        <div class="plan-card fade-up">
          <p class="plan-name">Тестовий місяць</p>
          <p class="plan-price">1 999 <span class="plan-currency">грн</span></p>
          <p class="plan-period">ліцензія на 1 місяць</p>
          <ul class="plan-features">
            <li>Ліцензія на 1 місяць</li>
            <li>Усі оновлення програми включені</li>
            <li>Повний доступ до всіх модулів</li>
          </ul>
          <button class="btn-primary" data-add-to-cart data-id="litopys-trial" data-name="Літопис — тестовий місяць" data-price="1999">Придбати →</button>
        </div>

        <div class="plan-card plan-featured fade-up" style="--d:.08s">
          <div class="plan-badge plan-badge-sale">−33% знижка</div>
          <p class="plan-name">Повна ліцензія</p>
          <p class="plan-price-old">15 000 грн</p>
          <p class="plan-price">9 999 <span class="plan-currency">грн</span></p>
          <p class="plan-period">одноразово, безстроково</p>
          <ul class="plan-features">
            <li>Ліцензія назавжди на 1 ПК</li>
            <li>Можливість розширити кількість користувачів</li>
            <li>Усі оновлення програми включені</li>
            <li>Повний доступ до всіх модулів</li>
          </ul>
          <button class="btn-white" data-add-to-cart data-id="litopys-license" data-name="Літопис — ліцензія" data-price="9999">Придбати →</button>
        </div>

        <div class="plan-card fade-up" style="--d:.16s">
          <p class="plan-name">Додатковий користувач</p>
          <p class="plan-price">4 998 <span class="plan-currency">грн</span></p>
          <p class="plan-period">розширення основної ліцензії</p>
          <ul class="plan-features">
            <li>Розширення основної ліцензії</li>
            <li>Робота з додаткового ПК з єдиним акаунтом</li>
            <li>Усі оновлення програми включені</li>
            <li>Повний доступ до всіх модулів</li>
          </ul>
          <button class="btn-primary" data-add-to-cart data-id="litopys-extra-user" data-name="Додатковий користувач" data-price="4998">Придбати →</button>
        </div>

      </div>

      <p class="plans-note fade-up">Плотер Silhouette Portrait 4 — окремо, не входить у вартість. Дивись розділ <a href="/shcho-potribno">«Що потрібно»</a>.</p>
    </div>
  </section>

  <!-- ══ FONTS ══ -->
  <section class="section-plans section-fonts">
    <div class="container">
      <p class="eyebrow fade-up">Рукописні шрифти</p>
      <div class="plans-grid">

        <div class="plan-card fade-up">
          <p class="plan-name">Індивідуальний шрифт</p>
          <p class="plan-price">4 899 <span class="plan-currency">грн</span></p>
          <p class="plan-period">розробка з вашого почерку</p>
          <ul class="plan-features">
            <li>Оцифруємо саме ваш почерк</li>
            <li>Варіативність — по 3 варіанти кожного символу</li>
            <li>Без ефекту "друкованого" тексту</li>
            <li>Готовий шрифт для роботи в Litopys</li>
          </ul>
          <button class="btn-primary" data-add-to-cart data-id="font-individual" data-name="Індивідуальний шрифт" data-price="4899">Замовити →</button>
        </div>

        <div class="plan-card fade-up" style="--d:.08s">
          <p class="plan-name">Готовий шрифт</p>
          <p class="plan-price">4 999 <span class="plan-currency">грн</span></p>
          <p class="plan-period">вибір із каталогу</p>
          <ul class="plan-features">
            <li>Кілька готових рукописних варіантів</li>
            <li>Перегляд превью перед покупкою</li>
            <li>Варіативність — по 3 варіанти кожного символу</li>
            <li>Без ефекту "друкованого" тексту</li>
            <li>Одразу готовий до використання</li>
          </ul>
          <a href="/shrifty" class="btn-primary">Обрати →</a>
        </div>

        <div class="plan-card fade-up" style="--d:.16s">
          <div class="plan-badge plan-badge-soon">В розробці</div>
          <p class="plan-name">Litograph</p>
          <p class="plan-price">0 <span class="plan-currency">грн</span></p>
          <p class="plan-period">в розробці</p>
          <ul class="plan-features">
            <li>Створюй свої власні шрифти</li>
            <li>Одна покупка — безлімітне користування</li>
            <li>Безлімітна кількість українських шрифтів</li>
            <li>Без ефекту "друкованого" тексту</li>
            <li>Готовий шрифт для роботи в Litopys</li>
          </ul>
          <button class="btn-primary" disabled title="Продукт в розробці">Купити →</button>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-card fade-up">
        <p class="eyebrow cta-eyebrow">Готові спробувати?</p>
        <h2>Відкрийте Літопис<br/>прямо зараз</h2>
        <p class="cta-sub">Протестуйте редактор у браузері — без реєстрації та завантажень.</p>
        <a href="/demo" class="btn-white">Відкрити демо →</a>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .fade-up {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .65s ease, transform .65s ease;
    transition-delay: var(--d, 0s);
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }
</style>

<style>
  .container { max-width: 1060px; margin: 0 auto; padding: 0 1.5rem; }
  .eyebrow {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #4f7cac;
    margin-bottom: 1rem;
  }

  /* ── Hero ── */
  .hero-page { position: relative; padding: 6rem 0 3rem; }
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 20% 40%, #dce8f5 0%, transparent 55%),
                radial-gradient(ellipse at 80% 60%, #f5ead8 0%, transparent 50%),
                #f8f9fb;
    pointer-events: none;
  }
  .hero-page h1 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1.12;
    color: #111827;
    margin-bottom: 1.25rem;
    max-width: 760px;
  }
  .hero-sub { font-size: 1.0625rem; color: #6b7280; line-height: 1.75; max-width: 620px; }

  /* ── Plans ── */
  .section-plans { padding: 3rem 0 5rem; }
  .section-fonts { padding-top: 0; }
  .plans-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; align-items: stretch; }
  .plan-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,.85);
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 2.25rem 2rem;
    backdrop-filter: blur(8px);
    transition: box-shadow .2s, transform .2s, border-color .2s;
    position: relative;
  }
  .plan-card:hover { box-shadow: 0 12px 32px rgba(0,0,0,.09); transform: translateY(-3px); border-color: #bfd4e8; }

  .plan-featured {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    color: #fff;
    border: none;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
  }
  .plan-featured:hover { box-shadow: 0 28px 72px rgba(0,0,0,.3); }
  .plan-badge {
    position: absolute;
    top: -14px;
    left: 2rem;
    background: #ffd500;
    color: #1a1a2e;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .03em;
    padding: .3rem .9rem;
    border-radius: 50px;
  }
  .plan-badge-soon { background: #e5e7eb; color: #6b7280; }
  .plan-badge-sale { background: #dc2626; color: #fff; }

  .plan-name { font-size: 1.0625rem; font-weight: 600; color: #6b7280; margin-bottom: .75rem; }
  .plan-featured .plan-name { color: rgba(255,255,255,.7); }
  .plan-price { font-size: 2.5rem; font-weight: 800; letter-spacing: -.03em; color: #111827; }
  .plan-featured .plan-price { color: #fff; }
  .plan-price-old {
    font-size: 1.125rem;
    font-weight: 600;
    color: #9ca3af;
    text-decoration: line-through;
    text-decoration-color: #dc2626;
    text-decoration-thickness: 2px;
    letter-spacing: -.01em;
    margin-bottom: .15rem;
  }
  .plan-featured .plan-price-old { color: rgba(255,255,255,.45); }
  .plan-currency { font-size: 1.125rem; font-weight: 600; }
  .plan-period { font-size: .875rem; color: #9ca3af; margin-bottom: 1.75rem; }
  .plan-featured .plan-period { color: rgba(255,255,255,.6); }

  .plan-features { list-style: none; display: flex; flex-direction: column; gap: .75rem; margin-bottom: 2rem; flex: 1; }
  .plan-features li {
    font-size: .875rem;
    color: #4b5563;
    line-height: 1.5;
    padding-left: 1.4rem;
    position: relative;
  }
  .plan-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: #4f7cac;
  }
  .plan-featured .plan-features li { color: rgba(255,255,255,.85); }
  .plan-featured .plan-features li::before { color: #ffd500; }

  .plans-note { text-align: center; color: #9ca3af; font-size: .875rem; margin-top: 2.5rem; }
  .plans-note a { text-decoration: underline; color: #6b7280; }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-block;
    background: #1a1a2e;
    color: #fff;
    padding: .8rem 1.9rem;
    border-radius: 50px;
    font-size: .9375rem;
    font-weight: 600;
    text-align: center;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .2s, transform .2s, box-shadow .2s;
    box-shadow: 0 4px 16px rgba(0,0,0,.2);
  }
  .btn-primary:hover { opacity: .85; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.25); }
  .btn-primary:disabled {
    opacity: .5;
    cursor: default;
    transform: none;
    box-shadow: none;
  }
  .btn-primary:disabled:hover { opacity: .5; transform: none; box-shadow: none; }
  .btn-white {
    display: inline-block;
    background: #fff;
    color: #1a1a2e;
    padding: .85rem 2.2rem;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: transform .2s, box-shadow .2s;
    box-shadow: 0 4px 20px rgba(0,0,0,.18);
  }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(0,0,0,.25); }
  .btn-added { opacity: .6 !important; cursor: default !important; transform: none !important; }

  /* ── CTA ── */
  .section-cta { padding: 3rem 0 8rem; }
  .cta-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    border-radius: 28px; padding: 5rem 3rem; text-align: center; color: #fff;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
    position: relative; overflow: hidden;
  }
  .cta-card::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,213,0,.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-card::after {
    content: '';
    position: absolute;
    bottom: -60px; left: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(0,91,187,.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-eyebrow { color: rgba(255,255,255,.5) !important; }
  .cta-card h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -.04em; line-height: 1.1; margin-bottom: 1rem;
    position: relative; z-index: 1;
  }
  .cta-sub { font-size: 1.0625rem; color: rgba(255,255,255,.7); margin-bottom: 2.5rem; line-height: 1.6; position: relative; z-index: 1; }

  @media (max-width: 900px) {
    .plans-grid { grid-template-columns: 1fr; }
    .plan-featured { order: -1; }
  }
  @media (max-width: 640px) {
    .cta-card { padding: 3rem 1.5rem; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cart = (window as any).LitopysCart;
      if (!cart) return;
      cart.addToCart({
        id: btn.dataset.id!,
        name: btn.dataset.name!,
        price: Number(btn.dataset.price),
        qty: 1,
      });
      const original = btn.textContent;
      btn.textContent = 'Додано ✓';
      btn.classList.add('btn-added');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('btn-added');
      }, 1400);
    });
  });
</script>
