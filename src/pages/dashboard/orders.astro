---
import Layout from '../../layouts/Layout.astro';

const { user } = Astro.locals;
const token = Astro.cookies.get('litopys_token')?.value ?? '';

let orders: any[] = [];
let catalog: any[] = [];

const authHeaders = { Authorization: `Bearer ${token}` };
const [ordersRes, catalogRes] = await Promise.allSettled([
  fetch('https://api.litopys.win/orders', { headers: authHeaders }).then((r) => r.json()),
  fetch('https://api.litopys.win/orders/catalog', { headers: authHeaders }).then((r) => r.json()),
]);
if (ordersRes.status === 'fulfilled' && ordersRes.value?.ok) orders = ordersRes.value.orders ?? [];
if (catalogRes.status === 'fulfilled' && catalogRes.value?.ok) catalog = catalogRes.value.catalog ?? [];

// «× 3 міс.» для LitoGraph, «× 2» для решти
function qtyText(i: any) {
  const qty = i.qty || 1;
  if (i.id === 'litograph-monthly') return ` × ${qty} міс.`;
  return qty > 1 ? ` × ${qty}` : '';
}

const statusBadge: Record<string, string> = {
  'Оформлено': 'badge-gray',
  'В роботі': 'badge-blue',
  'Виконано': 'badge-green',
  'Відхилено': 'badge-red',
};

function fmtDate(d: string | null | undefined) {
  if (!d) return '—';
  return new Date(d).toLocaleString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}

function fmtUAH(n: number) {
  return n.toLocaleString('uk-UA') + ' грн';
}
---

<Layout title="Мої замовлення — Літопис" noHeader={true}>
  <div class="dash-wrap">
    <aside class="sidebar">
      <div class="sidebar-logo">
        <img src="/litopys-logo-dark.png" alt="Літопис" />
      </div>
      <nav class="sidebar-nav">
        <a href="/dashboard" class="nav-item">
          <span class="nav-icon-svg"><img src="/icon-user.svg" alt="" /></span> Акаунт
        </a>
        <a href="/dashboard/licenses" class="nav-item">
          <span class="nav-icon-svg"><img src="/icon-key.svg" alt="" /></span> Ліцензія
        </a>
        <a href="/dashboard/orders" class="nav-item active">
          <span class="nav-icon-svg"><img src="/icon-cart.svg" alt="" /></span> Мої замовлення
        </a>
        <a href="/dashboard/security" class="nav-item">
          <span class="nav-icon-svg"><img src="/icon-fingerprint.svg" alt="" /></span> Безпека
        </a>
        {user?.role === 'admin' && (
          <a href="/dashboard/site-stats" class="nav-item">
            <span class="nav-icon-svg nav-icon-chart">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            </span> Статистика сайту
          </a>
        )}
      </nav>
      <div class="sidebar-bottom-links">
        <a href="https://api.litopys.win/download" class="sidebar-ext-link sidebar-download"><img src="/icon-download.svg" alt="" />Завантажити</a>
        <a href="/litopys" class="sidebar-ext-link"><img src="/icon-question.svg" alt="" />Про застосунок</a>
        <a href="/litopys/demo" class="sidebar-ext-link"><img src="/icon-play.svg" alt="" />Спробувати</a>
        <a href="https://api.litopys.win/download/litoscan" class="sidebar-ext-link sidebar-litoscan"><img src="/litoscan-badge.png" alt="" />LitoScan — безкоштовно</a>
      </div>
      <form method="POST" action="/api/logout" class="sidebar-logout">
        <button type="submit" class="logout-btn">Вийти</button>
      </form>
    </aside>

    <main class="dash-main">
      <div class="dash-header">
        <p class="dash-greeting">Мої замовлення</p>
        <p class="dash-email">{user?.name} · {user?.email}</p>
      </div>

      {orders.length === 0 ? (
        <section class="card">
          <p class="no-data">Замовлень поки немає. <a href="/tsiny" class="inline-link">Переглянути ціни →</a></p>
        </section>
      ) : (
        <div class="orders-list">
          {orders.map((o: any) => (
            <section class="card order-card" data-order-id={o.id} data-editable={o.editable ? '1' : '0'}>
              <div class="card-header">
                <h2>Замовлення №{o.orderNumber}</h2>
                <span class:list={['badge', statusBadge[o.status] ?? 'badge-gray']}>{o.status}</span>
              </div>

              <p class="order-date">{fmtDate(o.createdAt)}</p>

              {o.status === 'Відхилено' && o.rejectionReason && (
                <p class="order-rejection">Причина відхилення: {o.rejectionReason}</p>
              )}

              <ul class="order-items">
                {o.items.map((i: any, idx: number) => (
                  <li>
                    <span>
                      {i.name}{qtyText(i)}
                      {i.discountPerUnit > 0 && <span class="item-discount">−{Math.round(i.discountPerUnit / (i.originalPrice || 1) * 100)}%</span>}
                    </span>
                    <span class="order-item-right">
                      {i.confirmed && i.downloadFile && (
                        <button type="button" class="btn-download-font" data-order-id={o.id} data-item-index={idx}>Завантажити →</button>
                      )}
                      {fmtUAH(i.price * (i.qty || 1))}
                      {o.editable && !i.addedByAdmin && o.items.length > 1 && (
                        <button type="button" class="btn-item-remove" data-index={idx} title="Прибрати з замовлення" aria-label="Прибрати з замовлення">✕</button>
                      )}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="order-total">
                <p>Разом</p>
                <p class="order-total-sum">{fmtUAH(o.total)}</p>
              </div>

              {o.editable && catalog.length > 0 && (
                <div class="order-edit">
                  <p class="order-edit-note">Склад замовлення можна змінити, доки його не взяли в роботу.</p>
                  <div class="order-add">
                    <select class="order-add-select" aria-label="Товар">
                      <option value="">Додати товар…</option>
                      {catalog.map((p: any) => (
                        <option value={p.id} data-max={p.maxQty || 1} data-label={p.qtyLabel || ''}>
                          {p.name} — {fmtUAH(p.price)}{p.id === 'litograph-monthly' ? ' / міс.' : ''}
                        </option>
                      ))}
                    </select>
                    <label class="order-add-qty" hidden>
                      <span class="order-add-qty-label">Кількість</span>
                      <input type="number" min="1" value="1" />
                    </label>
                    <button type="button" class="btn-order-add" disabled>Додати</button>
                  </div>
                  <p class="order-edit-msg" hidden></p>
                </div>
              )}
            </section>
          ))}
        </div>
      )}
    </main>
  </div>
</Layout>

<style>
  .dash-wrap { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
  .sidebar { border-right: 1px solid #e5e7eb; padding: 1.5rem 1rem; display: flex; flex-direction: column; background: #fafafa; }
  .sidebar-logo img { height: 36px; margin-bottom: 2rem; }
  .sidebar-nav { display: flex; flex-direction: column; gap: .25rem; flex: 1; }
  .nav-item { display: flex; align-items: center; gap: .6rem; padding: .6rem .85rem; border-radius: 10px; font-size: .875rem; font-weight: 500; color: #374151; transition: background .15s, color .15s; }
  .nav-item:hover { background: #f3f4f6; color: #111827; }
  .nav-item.active { background: #1a1a2e; color: #fff; }
  .nav-icon-svg img { width: 16px; height: 16px; display: block; filter: brightness(0) saturate(100%); }
  .nav-item.active .nav-icon-svg img { filter: brightness(0) invert(1); }
  .nav-icon-chart { width: 16px; height: 16px; display: flex; color: #374151; }
  .nav-icon-chart svg { width: 16px; height: 16px; }
  .nav-item.active .nav-icon-chart { color: #fff; }
  .sidebar-bottom-links { display: flex; flex-direction: column; gap: .15rem; margin-bottom: .5rem; }
  .sidebar-ext-link { display: flex; align-items: center; gap: .6rem; font-size: .8125rem; color: #6b7280; padding: .4rem .85rem; border-radius: 8px; transition: color .15s, background .15s; }
  .sidebar-ext-link:hover { color: #111827; background: #f3f4f6; }
  .sidebar-ext-link img { width: 15px; height: 15px; display: block; filter: brightness(0) saturate(100%) invert(47%) sepia(7%) saturate(400%) hue-rotate(180deg); flex-shrink: 0; }
  .sidebar-ext-link:hover img { filter: brightness(0); }
  .sidebar-download { color: #1a1a2e; font-weight: 600; }
  .sidebar-download img { filter: brightness(0) !important; }
  .sidebar-litoscan img { border-radius: 4px; filter: none; }
  .sidebar-litoscan:hover img { filter: none; }
  .sidebar-logout { margin-top: 0; }
  .logout-btn { width: 100%; background: none; border: 1.5px solid #e5e7eb; border-radius: 10px; padding: .55rem; font-size: .8125rem; color: #6b7280; cursor: pointer; font-family: inherit; transition: border-color .15s, color .15s; }
  .logout-btn:hover { border-color: #dc2626; color: #dc2626; }

  .dash-main { padding: 2rem 2.5rem; max-width: 760px; }
  .dash-header { margin-bottom: 2rem; }
  .dash-greeting { font-size: 1.25rem; font-weight: 800; color: #111827; letter-spacing: -.02em; }
  .dash-email { font-size: .875rem; color: #6b7280; margin-top: .2rem; }

  .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.5rem; margin-bottom: 1.25rem; }
  .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; }
  .card-header h2 { font-size: 1rem; font-weight: 700; color: #111827; }

  .badge { font-size: .75rem; font-weight: 700; padding: .25rem .65rem; border-radius: 20px; white-space: nowrap; }
  .badge-green { background: #dcfce7; color: #15803d; }
  .badge-blue { background: #dbeafe; color: #1d4ed8; }
  .badge-gray { background: #f3f4f6; color: #6b7280; }
  .badge-red { background: #fee2e2; color: #dc2626; }

  .orders-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .order-date { font-size: .8125rem; color: #9ca3af; margin-bottom: 1.1rem; }
  .order-rejection { font-size: .875rem; color: #dc2626; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: .65rem .9rem; margin-bottom: 1.1rem; }

  .order-items { list-style: none; display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1rem; }
  .order-items li { display: flex; justify-content: space-between; align-items: center; font-size: .9375rem; color: #4b5563; gap: 1rem; }
  .order-item-right { display: flex; align-items: center; gap: .75rem; white-space: nowrap; }

  .order-total {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid #e5e7eb; padding-top: .85rem;
    font-weight: 800; font-size: 1.0625rem; color: #111827;
  }

  .btn-download-font {
    display: inline-block;
    background: #1a1a2e;
    color: #fff;
    padding: .35rem .9rem;
    border-radius: 50px;
    font-size: .8125rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .2s;
  }
  .btn-download-font:hover { opacity: .85; }
  .btn-download-font:disabled { opacity: .6; cursor: default; }

  .item-discount { margin-left: .4rem; font-size: .75rem; font-weight: 700; color: #dc2626; }
  .btn-item-remove {
    width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid #e5e7eb; background: #fff; color: #9ca3af;
    font-size: .8rem; cursor: pointer; font-family: inherit; line-height: 1; transition: color .15s, border-color .15s;
  }
  .btn-item-remove:hover { color: #dc2626; border-color: #dc2626; }
  .btn-item-remove:disabled { opacity: .5; cursor: default; }

  .order-edit { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px dashed #e5e7eb; }
  .order-edit-note { font-size: .8125rem; color: #6b7280; margin-bottom: .6rem; }
  .order-add { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .order-add-select { flex: 1 1 260px; min-width: 0; padding: .55rem .75rem; border: 1.5px solid #e5e7eb; border-radius: 10px; font: inherit; font-size: .875rem; background: #fff; }
  .order-add-qty { display: flex; align-items: center; gap: .4rem; font-size: .8125rem; color: #6b7280; }
  .order-add-qty[hidden] { display: none; }
  .order-add-qty input { width: 70px; padding: .5rem .6rem; border: 1.5px solid #e5e7eb; border-radius: 10px; font: inherit; }
  .btn-order-add { background: #1a1a2e; color: #fff; border: none; border-radius: 50px; padding: .55rem 1.2rem; font: inherit; font-size: .875rem; font-weight: 600; cursor: pointer; }
  .btn-order-add:disabled { opacity: .45; cursor: default; }
  .order-edit-msg { margin-top: .6rem; font-size: .8125rem; }
  .order-edit-msg.error { color: #dc2626; }
  .order-edit-msg.ok { color: #15803d; }

  .no-data { color: #6b7280; font-size: .9375rem; }
  .inline-link { color: #1a1a2e; font-weight: 600; }

  @media (max-width: 700px) {
    .dash-wrap { grid-template-columns: 1fr; }
    .sidebar { flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid #e5e7eb; padding: 1rem; }
    .sidebar-logo { display: none; }
    .sidebar-nav { flex-direction: row; flex-wrap: wrap; }
    .sidebar-logout { margin-top: 0; margin-left: auto; }
    .dash-main { padding: 1.25rem 1rem; }
  }
</style>

<script>
  function extractFilename(contentDisposition: string | null): string {
    if (!contentDisposition) return 'font.zip';
    const match = contentDisposition.match(/filename="?([^"]+)"?/);
    return match?.[1] ?? 'font.zip';
  }

  // ── Зміна складу замовлення клієнтом (поки статус «Оформлено») ──
  const EDIT_ERRORS: Record<string, string> = {
    order_locked: 'Замовлення вже взяли в роботу — змінити склад не можна.',
    last_item: 'Це остання позиція. Щоб скасувати замовлення, зв\'яжіться з нами.',
    item_added_by_admin: 'Цю позицію додав менеджер — прибрати її можна лише через нього.',
    invalid_qty: 'Неправильна кількість.',
    unknown_product: 'Такого товару немає в каталозі.',
  };
  const fmtUAH = (n: number) => n.toLocaleString('uk-UA') + ' грн';
  const qtyText = (i: any) => {
    const qty = i.qty || 1;
    if (i.id === 'litograph-monthly') return ` × ${qty} міс.`;
    return qty > 1 ? ` × ${qty}` : '';
  };

  function showMsg(card: HTMLElement, text: string, kind: 'ok' | 'error') {
    const msg = card.querySelector<HTMLElement>('.order-edit-msg');
    if (!msg) { if (kind === 'error') alert(text); return; }
    msg.textContent = text;
    msg.className = `order-edit-msg ${kind}`;
    msg.hidden = false;
  }

  // Перемальовує позиції й суму картки за відповіддю сервера.
  function renderOrder(card: HTMLElement, order: any) {
    const ul = card.querySelector('.order-items')!;
    ul.replaceChildren(...order.items.map((i: any, idx: number) => {
      const li = document.createElement('li');
      const left = document.createElement('span');
      left.textContent = `${i.name}${qtyText(i)}`;
      if (i.discountPerUnit > 0) {
        const d = document.createElement('span');
        d.className = 'item-discount';
        d.textContent = `−${Math.round(i.discountPerUnit / (i.originalPrice || 1) * 100)}%`;
        left.append(d);
      }
      const right = document.createElement('span');
      right.className = 'order-item-right';
      right.append(fmtUAH(i.price * (i.qty || 1)));
      if (order.editable && !i.addedByAdmin && order.items.length > 1) {
        const rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'btn-item-remove';
        rm.dataset.index = String(idx);
        rm.title = 'Прибрати з замовлення';
        rm.setAttribute('aria-label', 'Прибрати з замовлення');
        rm.textContent = '✕';
        right.append(rm);
      }
      li.append(left, right);
      return li;
    }));
    card.querySelector('.order-total-sum')!.textContent = fmtUAH(order.total);
    if (!order.editable) {
      card.dataset.editable = '0';
      card.querySelector('.order-edit')?.remove();
    }
  }

  async function changeOrder(card: HTMLElement, method: 'POST' | 'DELETE', url: string, body?: unknown) {
    const controls = card.querySelectorAll<HTMLButtonElement | HTMLSelectElement>('.btn-item-remove, .btn-order-add, .order-add-select');
    controls.forEach((c) => { c.disabled = true; });
    try {
      const res = await fetch(url, {
        method,
        headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      });
      if (res.status === 401) {
        window.location.href = `/login?next=${encodeURIComponent('/dashboard/orders')}`;
        return null;
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) {
        showMsg(card, EDIT_ERRORS[data.error] ?? 'Не вдалося змінити замовлення. Спробуйте ще раз.', 'error');
        if (data.error === 'order_locked') setTimeout(() => window.location.reload(), 2000);
        return null;
      }
      renderOrder(card, data.order);
      showMsg(card, 'Замовлення оновлено.', 'ok');
      return data.order;
    } catch {
      showMsg(card, 'Немає зв\'язку з сервером. Спробуйте ще раз.', 'error');
      return null;
    } finally {
      card.querySelectorAll<HTMLButtonElement | HTMLSelectElement>('.btn-item-remove, .order-add-select').forEach((c) => { c.disabled = false; });
      const sel = card.querySelector<HTMLSelectElement>('.order-add-select');
      const add = card.querySelector<HTMLButtonElement>('.btn-order-add');
      if (add) add.disabled = !sel?.value;
    }
  }

  document.addEventListener('click', async (e) => {
    const rm = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-item-remove');
    if (!rm) return;
    const card = rm.closest<HTMLElement>('.order-card')!;
    const name = rm.closest('li')?.querySelector('span')?.textContent?.trim() ?? 'позицію';
    if (!confirm(`Прибрати з замовлення «${name}»?`)) return;
    await changeOrder(card, 'DELETE', `/api/orders/${card.dataset.orderId}/items/${rm.dataset.index}`);
  });

  document.querySelectorAll<HTMLElement>('.order-card[data-editable="1"]').forEach((card) => {
    const sel = card.querySelector<HTMLSelectElement>('.order-add-select');
    const qtyWrap = card.querySelector<HTMLLabelElement>('.order-add-qty');
    const qtyInput = qtyWrap?.querySelector('input');
    const qtyLabel = card.querySelector<HTMLElement>('.order-add-qty-label');
    const add = card.querySelector<HTMLButtonElement>('.btn-order-add');
    if (!sel || !qtyWrap || !qtyInput || !add) return;

    sel.addEventListener('change', () => {
      const opt = sel.selectedOptions[0];
      const max = Number(opt?.dataset.max || 1);
      qtyWrap.hidden = !sel.value || max <= 1;
      qtyInput.max = String(max);
      qtyInput.value = '1';
      if (qtyLabel) qtyLabel.textContent = opt?.dataset.label ? `Кількість, ${opt.dataset.label}` : 'Кількість';
      add.disabled = !sel.value;
    });

    add.addEventListener('click', async () => {
      if (!sel.value) return;
      const max = Number(sel.selectedOptions[0]?.dataset.max || 1);
      const qty = Math.min(max, Math.max(1, Math.floor(Number(qtyInput.value) || 1)));
      const done = await changeOrder(card, 'POST', `/api/orders/${card.dataset.orderId}/items`, { id: sel.value, qty });
      if (done) {
        sel.value = '';
        sel.dispatchEvent(new Event('change'));
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.btn-download-font').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const orderId = btn.dataset.orderId;
      const itemIndex = btn.dataset.itemIndex;
      if (!orderId) return;

      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Завантаження…';

      try {
        const query = itemIndex !== undefined ? `?item=${itemIndex}` : '';
        const res = await fetch(`/api/download-font/${orderId}${query}`);
        if (res.status === 401) {
          window.location.href = `/login?next=${encodeURIComponent('/dashboard/orders')}`;
          return;
        }
        if (!res.ok) throw new Error('download failed');

        const blob = await res.blob();
        const filename = extractFilename(res.headers.get('content-disposition'));
        const blobUrl = URL.createObjectURL(blob);

        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(blobUrl);
      } catch {
        alert('Не вдалося завантажити файл. Спробуйте ще раз.');
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });
</script>
