  .settings-block input[type=range]::-moz-range-track {
    height: 2px; background: #0d1024; border-radius: 2px;
  }
  .settings-block input[type=range]::-moz-range-thumb {
    width: 14px; height: 14px; border-radius: 50%;
    background: #f4c716; cursor: pointer; border: none;
