    box-sizing: border-box;
    border-left: 0.25mm solid #000;
  }

  /* Горизонтальні рядки */
  .tpl-hline {
    position: absolute;
    box-sizing: border-box;
    border-top: 0.25mm solid #000;
  }

  /* Текст заголовків */
  .tpl-header {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: "Times New Roman", Times, serif;
    font-size: 7pt;
    font-weight: 700;
    line-height: 1.2;
    padding: 0 1mm;
    overflow: hidden;
  }

  /* Номери колонок */
  .tpl-num {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Times New Roman", Times, serif;
    font-size: 7pt;
    font-weight: 700;
  }

  /* Текстові клітинки */
  .tpl-cell {
    position: absolute;
    box-sizing: border-box;
    font-family: "Times New Roman", Times, serif;
    font-size: 7.5pt;
    line-height: 1.15;
    padding: 0 1mm;
    overflow: hidden;
    white-space: nowrap;
    color: #111;
  }

  /* ── Status bar ── */
  .status-bar {
    display: flex; align-items: center; gap: .75rem;
    height: 28px; padding: 0 14px; flex-shrink: 0;
    background: rgba(255,255,255,.92); border-top: 1px solid #e6dccd;
    font-size: 11px; color: #64748B;
  }
  .status-link { color: #0d1024; font-weight: 600; font-size: 11px; }
  .status-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .app-shell { grid-template-columns: 1fr; }
    .settings-panel, .blank-editor-panel { display: none; }
  }
</style>

<script>
// ══════════════════════════════════════════════════════
//  Стан — точно як DEFAULT_BLANK_TEMPLATE та DEFAULT_CALIBRATION у застосунку
// ══════════════════════════════════════════════════════
const blank = {
  header1: 'Дата, час',
  header2: 'Завдання військ та стисле висвітлення бойових дій',
  header3: 'Примітка',
  nums: '1,2,3',
  innerMargin: 10,   // мм від краю аркуша до таблиці
  mirrorOffset: 0,   // мм дзеркальне зміщення непарних/парних сторінок
  oneSided: false,   // односторонній шаблон (без дзеркалення)
  top: 20,           // мм зверху аркуша де починається таблиця
  bottom: 287,       // мм зверху аркуша де закінчується таблиця
  dateWidth: 30,     // мм
  textWidth: 120,    // мм
  noteWidth: 25,     // мм
  rows: 44,          // загальна кількість рядків
  headerRows: 2,     // рядків шапки
  lineWidth: 0.25,   // мм товщина ліній
};

const cal = {
  gridOpacity: 0.42,
  oddDateX: 0.5,
  oddTimeX: 0.5,
  oddTextX: 0.5,
  firstRowTop: 31.47,
  rowHeight: 6.084,
  baselineOffset: 6.07,
  textFontSize: 12,
  dateFontSize: 12,
  noteFontSize: 12,
  letterRotate: 0,
  letterJitterY: 0,
  spaceFactor: 0.25,
  charMicroSpacing: 0,
  useHandFont: true,
};

// Формат: { date, time, text, note }
// date і time виводяться окремими рядками в колонці "Дата"
const sampleRows = [
  {
    date: '24.02.2022', time: '03:40',
    text: 'Повномасштабне вторгнення почалося близько 3:40, коли на територію Луганської області зайшла перша колона російських танків',
    note: ''
  },
  {
    date: '24.02.2022', time: '04:00',
    text: 'Близько 4:00 за київським часом (UTC+2) 24 лютого президент рф вовапітун оголосив про воєнну операцію з метою нібито «демілітаризації та денацифікації України».',
    note: ''
  },
  {
    date: '06.07.2023', time: '02:50',
    text: 'Російські війська підірвали Каховську ГЕС. Підрив призвів до неконтрольованого витоку води з Каховського водосховища, що в свою чергу спричинило до катастрофічного підняття рівня води та затоплення населених пунктів нижче Каховського водосховища.',
    note: ''
  },
];

function $(id){ return document.getElementById(id); }

// ── Синхронізація firstRowTop/rowHeight з blank.rows/bottom ──
// У реальному застосунку (app-monolith.js: syncTextFlowToBlankRows) це
// одностороння дія, яка виконується лише коли міняється сам БЛАНК (права
// панель: кількість рядків/межі таблиці) — вона підлаштовує калібрування
// тексту під нову сітку. Вона НЕ виконується на кожен render(), інакше
// бігунки лівої панелі "Текст" (firstRowTop/rowHeight) миттєво стираються
// власним обчисленим значенням і стають нередагованими — саме це було
// причиною того, що ці повзунки візуально нічого не міняли.
function syncCalFromBlank(){
  const textRows = Math.max(1, blank.rows - blank.headerRows);
  const rowH = Number.isFinite(cal.rowHeight) && cal.rowHeight >= 2.5 ? cal.rowHeight : 6.084;
  cal.rowHeight = rowH;
  cal.firstRowTop = blank.bottom - textRows * rowH;
  // оновлюємо відповідні елементи лівої панелі
  const rh = $('rowHeight'); if(rh){ rh.value = cal.rowHeight.toFixed(3); const v=$('rowHeightValue'); if(v) v.textContent=cal.rowHeight.toFixed(3); }
  const ft = $('firstRowTop'); if(ft){ ft.value = cal.firstRowTop.toFixed(2); const v=$('firstRowTopValue'); if(v) v.textContent=cal.firstRowTop.toFixed(2); }
}

// ── Фактичний X (дзеркалення непарна/парна) ──
function syncActualXInfo(){
  const info = $('blankActualXInfo');
  if(!info) return;
  const oddX = blank.innerMargin;
  const evenX = blank.oneSided ? blank.innerMargin : Math.max(0, blank.innerMargin + blank.mirrorOffset);
  info.value = `${oddX.toFixed(1)} мм / ${evenX.toFixed(1)} мм`;
}

// ── Таблиця: побудова бланк-шару (лінії, заголовки, нумери) ──
function buildBlankLayer(){
  const L = blank.innerMargin;            // tableLeft мм
  const T = blank.top;
  const B = blank.bottom;
  const H = B - T;
  const DW = blank.dateWidth;
  const TW = blank.textWidth;
  const NW = blank.noteWidth;
  const W = DW + TW + NW;
  const ROW_H = H / blank.rows;
  const lw = blank.lineWidth;
  const HR = Math.max(1, Math.round(blank.headerRows));
  const nums = blank.nums.split(',').map(s=>s.trim());
  const op = cal.gridOpacity;

  let html = `<div style="position:absolute;inset:0;opacity:${op};">`;

  // Зовнішня рамка
  html += `<div class="tpl-border" style="left:${L}mm;top:${T}mm;width:${W}mm;height:${H}mm;border-width:${lw}mm;"></div>`;

  // Вертикальні лінії
  html += `<div class="tpl-vline" style="left:${L+DW}mm;top:${T}mm;height:${H}mm;border-left-width:${lw}mm;"></div>`;
  html += `<div class="tpl-vline" style="left:${L+DW+TW}mm;top:${T}mm;height:${H}mm;border-left-width:${lw}mm;"></div>`;

  // Горизонтальні лінії рядків (після шапки)
  for(let r = HR; r < blank.rows; r++){
    const y = T + r * ROW_H;
    html += `<div class="tpl-hline" style="left:${L}mm;top:${y}mm;width:${W}mm;border-top-width:${lw}mm;"></div>`;
  }

  // Лінія під шапкою (між заголовками і номерами, якщо headerRows=2)
  if(HR >= 2){
    const y = T + (HR-1)*ROW_H;
    html += `<div class="tpl-hline" style="left:${L}mm;top:${y}mm;width:${W}mm;border-top-width:${lw}mm;"></div>`;
  }

  // Заголовки колонок (верхній рядок шапки)
  html += `<div class="tpl-header" style="left:${L}mm;top:${T}mm;width:${DW}mm;height:${(HR-1)*ROW_H}mm;">${blank.header1}</div>`;
  html += `<div class="tpl-header" style="left:${L+DW}mm;top:${T}mm;width:${TW}mm;height:${(HR-1)*ROW_H}mm;">${blank.header2}</div>`;
  html += `<div class="tpl-header" style="left:${L+DW+TW}mm;top:${T}mm;width:${NW}mm;height:${(HR-1)*ROW_H}mm;">${blank.header3}</div>`;

  // Номери колонок (нижній рядок шапки)
  const numY = T + (HR-1)*ROW_H;
  html += `<div class="tpl-num" style="left:${L}mm;top:${numY}mm;width:${DW}mm;height:${ROW_H}mm;">${nums[0]||'1'}</div>`;
  html += `<div class="tpl-num" style="left:${L+DW}mm;top:${numY}mm;width:${TW}mm;height:${ROW_H}mm;">${nums[1]||'2'}</div>`;
  html += `<div class="tpl-num" style="left:${L+DW+TW}mm;top:${numY}mm;width:${NW}mm;height:${ROW_H}mm;">${nums[2]||'3'}</div>`;

  html += `</div>`;
  $('jbd-blank-layer').innerHTML = html;
}

// ── Розбиття тексту по рядках таблиці ──
// Повертає масив рядків — скільки поміщається у кожному рядку
// Використовує Canvas для вимірювання ширини тексту
function splitTextIntoRows(text, fontStr, fontSizePt, colWidthMm) {
  if(!text) return [];
  // Конвертуємо мм → px (96dpi: 1mm = 3.7795px)
  const PX_PER_MM = 3.7795;
  const maxPx = colWidthMm * PX_PER_MM;
  const fontSizePx = fontSizePt * (96/72);

  // Canvas для вимірювання
  const cv = document.createElement('canvas');
  const ctx = cv.getContext('2d');
  ctx.font = `${fontSizePx}px ${fontStr}`;

  const words = text.split(' ');
  const lines = [];
  let current = '';

  for(const word of words){
    const test = current ? current + ' ' + word : word;
    if(ctx.measureText(test).width <= maxPx){
      current = test;
    } else {
      if(current) lines.push(current);
      current = word;
    }
  }
  if(current) lines.push(current);
  return lines;
}

// ── Детермінований псевдо-рандом (стабільний між рендерами, без "стрибків") ──
// Простий рядковий хеш → [0,1). Той самий підхід за духом, що й
// litopysSeededRandom у реальному застосунку: seed залежить від тексту й
// позиції символу, тому повторний render() з тими самими даними дає той
// самий результат, а не "тремтіння" на кожен кадр.
function seededRandom(seed, step){
  let h = 0;
  const s = seed + '|' + step;
  for(let i = 0; i < s.length; i++){
    h = (h * 31 + s.charCodeAt(i)) | 0;
  }
  h = Math.sin(h) * 10000;
  return h - Math.floor(h);
}

// Розбиває текст на <span> по символах, застосовуючи letter-rotate/jitter/
// spacing з панелі "Текст" — CSS-наближення рукописного вигляду замість
// повного canvas-рушія гліфів реального застосунку.
function renderHandChars(text, seedBase){
  const maxRot = cal.letterRotate || 0;
  const maxY   = cal.letterJitterY || 0;
  const micro  = cal.charMicroSpacing || 0;
  let step = 0;
  let out = '';
  for(const ch of text){
    if(ch === ' '){ out += ' '; continue; }
    const rot = maxRot ? (-maxRot + seededRandom(seedBase, step++) * maxRot * 2) : 0;
    const dy  = maxY   ? (-maxY   + seededRandom(seedBase, step++) * maxY * 2)   : 0;
    const extra = micro ? seededRandom(seedBase, step++) * micro : 0;
    const transform = (rot || dy) ? ` transform:rotate(${rot.toFixed(2)}deg) translateY(${dy.toFixed(2)}mm);` : '';
    const spacing = extra ? ` margin-right:${extra.toFixed(3)}mm;` : '';
    out += `<span style="display:inline-block;${transform}${spacing}">${esc(ch)}</span>`;
  }
  return out;
}

// ── Текст-шар (зразкові дані) ──
// ВАЖЛИВО: позиція рядків тексту рахується з cal.firstRowTop/cal.rowHeight
// (ліва панель "Текст"), а НЕ з сітки blank.top/blank.bottom/blank.rows
// (права панель "Бланк"). Сітка бланка малює лише лінії/заголовки в
// buildBlankLayer(); калібрування тексту — окрема, незалежно
// регульована прив'язка "рукопису" до цієї сітки (як у реальному
// застосунку: одна лінійка на бланку, калібрування друку регулюється
// окремо, щоб влучити в надрукований фізичний бланк).
function buildTextLayer(){
  const L  = blank.innerMargin;
  const DW = blank.dateWidth;
  const TW = blank.textWidth;
  const NW = blank.noteWidth;

  const font = cal.useHandFont
    ? 'OleksiiFull,Times New Roman,Times,serif'
    : 'Times New Roman,Times,serif';
  const fontStr = font.replace(/,/g,', ');

  // Приблизний ascent рукописного шрифту відносно em — щоб top блоку
  // (а не base line) був вирахуваний з baselineOffset так само, як
  // getPreviewTextTop() у реальному застосунку.
  const ASCENT_RATIO = 0.78;
  const mmPerPt = 0.3528;

  // Будуємо список рядків таблиці з розбиттям тексту
  // Колонка "Дата": перший рядок = дата (відступ oddDateX),
  //                 другий рядок = час (відступ oddTimeX),
  //                 далі порожньо
  // Колонка "Текст": рядки тексту з переносом, розмір шрифту — textFontSize
  // Колонка "Примітка": розмір шрифту — noteFontSize
  const tableRows = [];

  sampleRows.forEach(row => {
    const dateStr = row.date || '';
    const timeStr = row.time || '';
    const textLines = splitTextIntoRows(row.text||'', fontStr, cal.textFontSize, TW - cal.oddTextX - 1);
    const noteLines = splitTextIntoRows(row.note||'', fontStr, cal.noteFontSize, NW - 1.5);

    // Колонка дати: дата на 1-му рядку, час на 2-му, решта порожньо
    const dateCol = [];
    if(dateStr) dateCol.push({ val: dateStr, xOff: cal.oddDateX });
    if(timeStr) dateCol.push({ val: timeStr, xOff: cal.oddTimeX });

    const maxLines = Math.max(dateCol.length, textLines.length, noteLines.length, 1);
    for(let l = 0; l < maxLines; l++){
      tableRows.push({
        dateCell: dateCol[l] || null,   // { val, xOff } або null
        text:     textLines[l] || '',
        note:     noteLines[l] || '',
      });
    }
  });

  const wordSpacing = (cal.spaceFactor||0) * cal.textFontSize * mmPerPt;

  let html = '';
  tableRows.forEach((row, i) => {
    // rowTop рахується від cal.firstRowTop/cal.rowHeight — не від сітки бланка.
    const rowTop = cal.firstRowTop + i * cal.rowHeight;
    if(rowTop >= blank.bottom) return;

    const styleFor = (fontSizePt) => {
      const ascentMm = fontSizePt * mmPerPt * ASCENT_RATIO;
      const top = rowTop + cal.baselineOffset - ascentMm;
      return `position:absolute;box-sizing:border-box;`
        + `font-family:${font};font-size:${fontSizePt}pt;line-height:1;`
        + `overflow:hidden;white-space:nowrap;word-spacing:${wordSpacing.toFixed(3)}mm;`
        + `top:${top.toFixed(3)}mm;`;
    };

    if(row.dateCell){
      const xOff = row.dateCell.xOff;
      const seed = `date|${i}|${row.dateCell.val}`;
      html += `<div style="${styleFor(cal.dateFontSize)}left:${(L+xOff).toFixed(2)}mm;width:${(DW-xOff-0.5).toFixed(2)}mm;">${renderHandChars(row.dateCell.val, seed)}</div>`;
    }
    if(row.text){
      const seed = `text|${i}|${row.text}`;
      html += `<div style="${styleFor(cal.textFontSize)}left:${(L+DW+cal.oddTextX).toFixed(2)}mm;width:${(TW-cal.oddTextX-0.5).toFixed(2)}mm;">${renderHandChars(row.text, seed)}</div>`;
    }
    if(row.note){
      const seed = `note|${i}|${row.note}`;
      html += `<div style="${styleFor(cal.noteFontSize)}left:${(L+DW+TW+0.5).toFixed(2)}mm;width:${(NW-1).toFixed(2)}mm;">${renderHandChars(row.note, seed)}</div>`;
    }
  });

  $('jbd-text-layer').innerHTML = html;
}

function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function render(){
  syncActualXInfo();
  buildBlankLayer();
  buildTextLayer();
  const ti = $('blankTextRowsInfo');
  if(ti) ti.value = Math.max(0, blank.rows - blank.headerRows);
}

// ── Масштабування ──
function scalePreview(){
  const preview = $('preview');
  const area = document.querySelector('.preview-area');
  if(!preview || !area) return;
  const scale = Math.min((area.clientHeight-20)/1123, (area.clientWidth-20)/794, 1);
  preview.style.transform = `scale(${scale})`;
  preview.style.transformOrigin = 'top center';
}

// ── Прив'язка бігунків лівої панелі (Текст) ──
function bindCal(id, key, decimals){
  const el = $(id); if(!el) return;
  const val = $(id+'Value')||$(id+'Val');
  el.addEventListener('input', ()=>{
    cal[key] = parseFloat(el.value);
    if(val) val.textContent = parseFloat(el.value).toFixed(decimals==null?2:decimals);
    render();
  });
}
bindCal('oddDateX','oddDateX',1);
bindCal('oddTimeX','oddTimeX',1);
bindCal('oddTextX','oddTextX',1);
bindCal('firstRowTop','firstRowTop',2);
bindCal('rowHeight','rowHeight',3);
bindCal('baselineOffset','baselineOffset',2);
bindCal('dateFontSize','dateFontSize',1);
bindCal('textFontSize','textFontSize',1);
bindCal('noteFontSize','noteFontSize',1);
bindCal('letterRotate','letterRotate',1);
bindCal('letterJitterY','letterJitterY',1);
bindCal('spaceFactor','spaceFactor',2);
bindCal('charMicroSpacing','charMicroSpacing',2);
// rowHeight і firstRowTop керуються бігунками лівої панелі "Текст" (bindCal
// вище), але перераховуються заново (syncCalFromBlank), коли міняється сама
// сітка бланка (кількість рядків / межі таблиці) — див. ROW_FLOW_BLANK_KEYS
// нижче, так само як updateBlankTemplateFromControls() у реальному
// застосунку викликає syncTextFlowToBlankRows() лише на зміну бланка.

// Поля бланка, від яких залежить розкладка текстових рядків (аналог
// PAGE_FIT_BLANK_IDS/syncTextFlowToBlankRows у app-monolith.js) — зміна
// будь-якого з них підлаштовує cal.firstRowTop/cal.rowHeight під нову
// сітку, не чіпаючи решту калібрування тексту.
const ROW_FLOW_BLANK_KEYS = new Set(['rows','bottom','headerRows']);

// ── Прив'язка бігунків правої панелі (Бланк) ──
function bindRight(id, key, isText){
  const el = $(id); if(!el) return;
  const val = $(id+'Value')||$(id+'Val');
  el.addEventListener('input', ()=>{
    if(isText){ blank[key] = el.value; }
    else { blank[key] = parseFloat(el.value); }
    if(val && !isText) val.textContent = parseFloat(el.value).toFixed(2);
    if(ROW_FLOW_BLANK_KEYS.has(key)) syncCalFromBlank();
    render();
  });
}

bindRight('blankHeader1','header1',true);
bindRight('blankHeader2','header2',true);
bindRight('blankHeader3','header3',true);
bindRight('blankNums','nums',true);
bindRight('blankInnerMargin','innerMargin');
bindRight('blankMirrorOffset','mirrorOffset');
bindRight('blankTop','top');
bindRight('blankBottom','bottom');
bindRight('blankDateWidth','dateWidth');
bindRight('blankTextWidth','textWidth');
bindRight('blankNoteWidth','noteWidth');
bindRight('blankRows','rows');
bindRight('blankHeaderRows','headerRows');
bindRight('blankLineWidth','lineWidth');

// Checkbox: односторонній шаблон
const oneSidedEl = $('blankOneSided');
if(oneSidedEl){
  oneSidedEl.addEventListener('change', ()=>{
    blank.oneSided = oneSidedEl.checked;
    render();
  });
}

// Grid opacity (Бланк block, right panel)
bindCal('gridOpacity','gridOpacity',2);

// Checkboxes — preview toggles
const showGridEl = $('showTemplateGrid');
if(showGridEl){
  showGridEl.addEventListener('change', ()=>{
    const layer = $('jbd-blank-layer');
    if(layer) layer.style.display = showGridEl.checked ? '' : 'none';
  });
}
const hideTextEl = $('hidePreviewText');
if(hideTextEl){
  hideTextEl.addEventListener('change', ()=>{
    const layer = $('jbd-text-layer');
    if(layer) layer.style.display = hideTextEl.checked ? 'none' : '';
  });
}

// Рукопис: перемикач шрифту (декоративний — впливає лише на прев'ю)
const useHandFontEl = $('handwritingFontPack');
if(useHandFontEl){
  useHandFontEl.addEventListener('change', ()=>{
    cal.useHandFont = true; // єдиний доступний набір у демо
    render();
  });
}

// Range → span для будь-яких інших повзунків (запасний варіант)
document.querySelectorAll('input[type=range]').forEach(inp=>{
  const span=$(inp.id+'Value')||$(inp.id+'Val');
  if(span && !span.textContent) span.textContent=inp.value;
  // Не перепризначаємо — вже прив'язано вище
});

// ── Скидання налаштувань (демо: повертає значення за замовчуванням) ──
const defaultsCal = { ...cal };
const defaultsBlank = { ...blank };
function resetGroup(ids, store, defaults){
  ids.forEach(id=>{
    const el = $(id); if(!el) return;
    const key = el.dataset.key || id;
  });
}
$('btn-reset-text')?.addEventListener('click', ()=>{
  Object.assign(cal, defaultsCal);
  ['oddDateX','oddTimeX','oddTextX','firstRowTop','rowHeight','baselineOffset','dateFontSize','textFontSize','noteFontSize','letterRotate','letterJitterY','spaceFactor','charMicroSpacing'].forEach(id=>{
    const el=$(id); if(!el) return;
    const key=id; el.value = cal[key];
    const v=$(id+'Value'); if(v) v.textContent = el.value;
  });
  render();
});
$('btn-reset-blank')?.addEventListener('click', ()=>{
  Object.assign(blank, defaultsBlank);
  ['blankHeader1','blankHeader2','blankHeader3','blankNums','blankInnerMargin','blankMirrorOffset','blankTop','blankBottom','blankDateWidth','blankTextWidth','blankNoteWidth','blankRows','blankHeaderRows','blankLineWidth'].forEach(id=>{
    const el=$(id); if(!el) return;
    const key = id.replace('blank','');
    const mapped = key.charAt(0).toLowerCase()+key.slice(1);
    if(mapped in blank){ el.value = blank[mapped]; const v=$(id+'Value'); if(v) v.textContent = el.value; }
  });
  const oneSided = $('blankOneSided'); if(oneSided) oneSided.checked = blank.oneSided;
  syncCalFromBlank();
  render();
});

// ── Dropdown toggles (топбар) ──
function closeAllDropdowns(){
  document.querySelectorAll('.compact-dropdown.open').forEach(el=>el.classList.remove('open'));
  $('profileMenu')?.classList.remove('open');
}
function toggleDropdown(id){
  const el = $(id);
  if(!el) return;
  const wasOpen = el.classList.contains('open');
  closeAllDropdowns();
  if(!wasOpen) el.classList.add('open');
}
$('btn-twm')?.addEventListener('click', e=>{ e.stopPropagation(); toggleDropdown('textWorkMenu'); });
$('btn-pdf-save')?.addEventListener('click', e=>{ e.stopPropagation(); toggleDropdown('pdfSaveMenu'); });
$('btn-pdf-print')?.addEventListener('click', e=>{ e.stopPropagation(); toggleDropdown('pdfPrintMenu'); });
$('btn-project')?.addEventListener('click', e=>{ e.stopPropagation(); toggleDropdown('projectMenu'); });
$('btn-menu')?.addEventListener('click', e=>{ e.stopPropagation(); $('profileMenu')?.classList.toggle('open'); });
document.addEventListener('click', ()=>{ closeAllDropdowns(); });
$('btn-undo')?.addEventListener('click', ()=>{});
$('btn-redo')?.addEventListener('click', ()=>{});
$('btn-plotter')?.addEventListener('click', ()=>{});
$('btn-load-docx')?.addEventListener('click', ()=>{});

