    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(15,23,42,.06);
    min-height: 40px;
    position: relative; z-index: 100;
  }
  .app-title { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .brand-logo-link { display: flex; align-items: center; text-decoration: none; }
  .brand-logo-img { width: 148px; height: 47px; object-fit: contain; display: block; }
  .demo-chip {
    font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
    color: #64748B; background: #F1F5F9; border: 1px solid #e6dccd;
    border-radius: 4px; padding: 2px 5px;
  }
  .controls { display: flex; align-items: center; gap: 8px; flex-wrap: nowrap; }
  .topbar-actions { margin-left: auto; flex: 0 0 auto; width: auto; justify-content: flex-end; }
  .topbar-sep { width: 1px; height: 28px; background: rgba(100,116,139,.32); margin: 0 4px; flex-shrink: 0; }
  .document-history-actions { display: flex; gap: 4px; }

  /* Icon-only — біла кнопка з рамкою, як в реальному застосунку */
  button.icon-only {
    width: 38px !important; min-width: 38px !important; height: 38px !important;
    padding: 0 !important; display: inline-flex !important;
    align-items: center !important; justify-content: center !important;
    border: 1px solid #d8c9b8 !important; border-radius: 11px !important;
    background: #FFFFFF !important; color: #0d1024 !important;
    box-shadow: 0 2px 7px rgba(15,23,42,.06) !important; cursor: pointer; font-weight: 650 !important;
    transition: background .14s ease, box-shadow .14s ease, transform .14s ease !important; transform: none !important;
  }
  button.icon-only:hover {
    background: #F8FAFC !important;
    box-shadow: 0 0 0 3px rgba(13,16,36,.08), 0 7px 18px rgba(15,23,42,.11) !important;
    transform: translateY(-1px) !important;
  }

  /* "Робота з текстом" — темна pill-кнопка, як manual-text-import-button в реальному застосунку */
  .text-work-menu { position: relative; }
  .dropdown-caret { font-size: 10px; opacity: .75; }
  .manual-text-import-button.icon-only {
    background: #0d1024 !important; color: #fff !important;
    border: 1px solid #2f2f2f !important;
    box-shadow: 0 4px 12px rgba(15,23,42,.18) !important;
  }
  .manual-text-import-button.icon-only:hover {
    background: #4a4a4a !important; border-color: #555 !important;
    box-shadow: 0 0 0 3px rgba(13,16,36,.14), 0 8px 20px rgba(15,23,42,.20) !important;
    transform: translateY(-1px) !important;
  }

  /* File picker pill */
  .file-picker-pill {
    display: inline-flex; align-items: center; gap: 9px;
    height: 40px; padding: 0 14px;
    border: 1px solid #d8c9b8 !important; border-radius: 12px !important;
    background: #FFFFFF !important; color: #0d1024 !important;
    font-size: 13px; font-weight: 500; font-family: inherit; cursor: pointer;
    box-shadow: 0 2px 7px rgba(15,23,42,.06) !important;
    transform: none !important; transition: background .14s ease !important;
  }
  .file-picker-pill:hover { background: #F8FAFC !important; transform: none !important; }
  .file-picker-name { font-size: 13px; white-space: nowrap; }

  /* Compact dropdown */
  .pdf-save-menu, .pdf-action-menu, .text-work-menu { position: relative; }
  .compact-dropdown {
    display: none; position: absolute; top: calc(100% + 8px); left: 0;
    min-width: 200px; background: #fff; border: 1px solid #e6dccd;
    border-radius: 14px; box-shadow: 0 18px 44px rgba(15,23,42,.18);
    padding: 8px; z-index: 3500;
  }
  .compact-dropdown.open { display: grid; gap: 4px; }
  .compact-dropdown-label {
    padding: 6px 10px 3px; font-size: 10px; font-weight: 700;
