    padding: 9px 10px !important; border-radius: 9px !important;
    background: #fff !important; color: #0d1024 !important;
    font-size: 13px !important; font-weight: 500 !important; font-family: inherit !important;
    border: 1px solid transparent !important; box-shadow: none !important;
    cursor: pointer !important; transform: none !important;
  }
  .compact-dropdown button:hover { background: #F8FAFC !important; border-color: #e6dccd !important; }

  /* Demo-locked affordance — decorative controls that show "full version only" */
  .demo-locked { cursor: not-allowed !important; opacity: .55; }
  .demo-locked:hover { background: transparent !important; }
  .full-width-btn {
    display: block; width: 100%; margin: 8px 0;
    padding: 7px 9px; border: 1px solid #d8c9b8 !important; border-radius: 8px !important;
    background: #fff !important; color: #0d1024 !important;
    font-size: 12px; font-weight: 500; font-family: inherit;
  }

  /* Profile menu */
  .topbar-profile {
    flex: 0 0 auto; margin-left: 8px; padding-left: 16px;
    border-left: 1px solid #e6dccd; align-self: center;
    display: flex; align-items: center; position: relative;
  }
  .profile-menu {
    display: none; position: absolute; right: 0; top: calc(100% + 8px);
    min-width: 190px; background: #fff; border: 1px solid #e6dccd;
    border-radius: 14px; box-shadow: 0 18px 44px rgba(15,23,42,.18);
    padding: 8px; z-index: 3000;
  }
  .profile-menu.open { display: block; }
  .profile-menu-divider { height: 1px; background: #e6dccd; margin: 5px 2px; }
  .pmenu-link {
    display: flex; align-items: center; gap: 10px; padding: 9px 10px;
    border-radius: 9px; color: #0d1024; font-size: 13px; font-weight: 500;
    transition: background .1s;
  }
  .pmenu-link:hover { background: #F8FAFC; }

  /* ══ APP SHELL — точна сітка JBD ══ */
  .app-shell {
    display: grid;
    grid-template-columns: 240px 1fr 260px;
    gap: 14px;
    flex: 1;
    overflow: hidden;
    padding: 14px;
    align-items: start;
    min-height: 0;
  }

  /* ── Бічні панелі ── */
  .settings-panel,
  .blank-editor-panel {
    position: sticky; top: 0;
    max-height: calc(100vh - 58px - 28px);
    overflow-y: auto;
    background: #FFFFFF;
    border: 1px solid #e6dccd;
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 8px 24px rgba(15,23,42,.07);
    scrollbar-width: thin;
    scrollbar-color: #d8c9b8 transparent;
  }
  .settings-panel h2,
  .blank-editor-panel h2 {
    margin: 0 0 14px; font-size: 15px; font-weight: 800;
    color: #0d1024; letter-spacing: -.02em;
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 10px; border-bottom: 1px solid #e6dccd;
  }
  .panel-menu-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border: 1px solid #e6dccd; border-radius: 6px;
    background: #FFFFFF; color: #0d1024; font-size: 13px;
    box-shadow: 0 2px 8px rgba(15,23,42,.05);
    cursor: pointer; flex-shrink: 0; user-select: none;
  }

  /* Settings blocks */
  .settings-block {
    background: #FFFFFF; border: 1px solid #e6dccd;
    border-radius: 12px; padding: 12px; margin-top: 12px;
  }
  .settings-block h3 {
    font-size: 11.5px; font-weight: 800; color: #0d1024;
    letter-spacing: -.01em; margin-bottom: 8px;
    display: flex; align-items: center; gap: 5px;
  }
  .settings-info-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; height: 16px; margin-left: auto;
    background: transparent; color: #64748B; font-size: 12px; font-weight: 400;
    cursor: help; flex-shrink: 0; opacity: .7; transition: opacity .14s ease;
  }
  .settings-info-icon:hover { opacity: 1; }
  .settings-block label {
    display: block; margin: 8px 0; font-size: 12px; color: #0d1024; line-height: 1.4;
  }
  .settings-block label.inline-number-label {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
  }
  .inline-number-input { width: 70px !important; margin-top: 0 !important; }
  .settings-block input[type=text],
  .settings-block input[type=number],
  .settings-block select {
    width: 100%; box-sizing: border-box; padding: 7px 9px; margin-top: 5px;
    border: 1px solid #d8c9b8 !important; border-radius: 8px !important;
    background: #FFFFFF !important; color: #0d1024 !important;
    font-size: 12px; font-family: inherit;
