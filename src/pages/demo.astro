    font-display: swap;
  }

  :root { --letter-rotate: 0deg; }

  /* Нахил літер рукопису */
  #jbd-tbody td {
    font-style: oblique var(--letter-rotate);
  }

  /* ── Root ── */
  * { box-sizing: border-box; margin: 0; padding: 0; }

  .demo-root {
    display: flex; flex-direction: column;
    height: 100%;
