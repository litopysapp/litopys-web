  .settings-block input[type=text]:focus,
  .settings-block input[type=number]:focus,
  .settings-block select:focus {
    border-color: #0d1024 !important;
    box-shadow: 0 0 0 3px rgba(51,65,85,.12) !important;
    outline: none;
  }
  .settings-block input[readonly] { color: #64748B !important; background: #F1F5F9 !important; }
  /* Повзунки — 1:1 з реальним застосунком: тонкий темний трек, жовтий круглий thumb */
  .settings-block input[type=range] {
    width: 100%; margin-top: 5px;
    -webkit-appearance: none; appearance: none;
    height: 14px; background: transparent;
  }
  .settings-block input[type=range]::-webkit-slider-runnable-track {
    height: 2px; background: #0d1024; border-radius: 2px;
  }
  .settings-block input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
