---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Демо редактора — Літопис" description="Спробуйте Літопис прямо в браузері." fullPage={true}>

<div class="demo-root">

  <!-- ═══ TOPBAR ═══ -->
  <header class="app-topbar">
    <div class="app-title">
      <a href="/" class="brand-logo-link">
        <img src="/litopys-logo-dark.png" alt="Літопис демо" class="brand-logo-img">
      </a>
    </div>

    <div class="controls topbar-actions">
      <!-- Undo/Redo -->
      <div class="document-history-actions">
        <button id="btn-undo" class="icon-only" title="Скасувати останню зміну" aria-label="Скасувати останню зміну">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
        </button>
        <button id="btn-redo" class="icon-only" title="Повернути зміну" aria-label="Повернути зміну">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg>
        </button>
      </div>
      <div class="topbar-sep"></div>

      <!-- "Робота з текстом" -->
      <div class="text-work-menu" id="twm-wrap">
        <button class="manual-text-import-button icon-only" id="btn-twm" title="Робота з текстом" aria-label="Робота з текстом">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 21h8"/><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/></svg>
        </button>
        <div id="textWorkMenu" class="compact-dropdown">
          <button class="demo-locked" title="Доступно у повній версії">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12h8M12 8v8"/></svg>
            <span>Вставити текст</span>
          </button>
          <button class="demo-locked" title="Доступно у повній версії">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
            <span>Внести правки</span>
          </button>
          <button class="demo-locked" title="Доступно у повній версії">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            <span>Скинути правки</span>
          </button>
        </div>
      </div>

      <!-- DOCX pill -->
      <button id="btn-export-docx" class="file-picker-pill" title="Обрати DOCX">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
        <span class="file-picker-name" id="selectedFileLabel">DOCX</span>
      </button>

      <button id="btn-load-docx" class="icon-only demo-locked" title="Завантажити DOCX" aria-label="Завантажити DOCX">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
      </button>

      <!-- "Зберегти PDF" -->
      <div class="pdf-save-menu pdf-action-menu" id="pdfSaveWrap">
        <button class="icon-only" id="btn-pdf-save" title="Зберегти PDF" aria-label="Зберегти PDF">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        </button>
        <div id="pdfSaveMenu" class="compact-dropdown pdf-export-menu">
          <div class="compact-dropdown-label">Зберегти PDF</div>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span>Бланк</span></button>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span>Текст</span></button>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg><span>Бланк + текст</span></button>
        </div>
      </div>

      <!-- "Друк PDF" -->
      <div class="pdf-save-menu pdf-print-menu" id="pdfPrintWrap">
        <button class="icon-only" id="btn-pdf-print" title="Друк PDF" aria-label="Друк PDF">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>
        </button>
        <div id="pdfPrintMenu" class="compact-dropdown pdf-export-menu">
          <div class="compact-dropdown-label">Друк</div>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span>Бланк</span></button>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span>Текст</span></button>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/></svg><span>Бланк + текст</span></button>
        </div>
      </div>

      <!-- "Проект" -->
      <div class="pdf-save-menu pdf-action-menu" id="projectWrap">
        <button class="icon-only" id="btn-project" title="Проект" aria-label="Проект">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h5l2 3h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
        </button>
        <div id="projectMenu" class="compact-dropdown pdf-export-menu">
          <div class="compact-dropdown-label">Проект</div>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg><span>Зберегти проект</span></button>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v4h7"/></svg><span>Зберегти як...</span></button>
          <button class="demo-locked" title="Доступно у повній версії"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3h9l5 5v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M9 12l3 3 3-3"/></svg><span>Відкрити проект</span></button>
        </div>
      </div>

      <!-- Плотер -->
      <button id="btn-plotter" class="icon-only demo-locked" title="Написати плотером" aria-label="Написати плотером">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
      </button>
    </div>

    <div class="topbar-profile">
      <button class="icon-only menu-button" id="btn-menu" title="Меню" aria-label="Меню">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/></svg>
      </button>
      <div id="profileMenu" class="profile-menu">
        <div class="compact-dropdown-label">Демо-версія</div>
        <button class="demo-locked" title="Доступно у повній версії">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Профіль</span>
        </button>
        <button class="demo-locked" title="Доступно у повній версії">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Налаштування</span>
        </button>
        <div class="profile-menu-divider"></div>
        <a href="/" class="pmenu-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
          <span>На головну</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ═══ APP SHELL — три колонки як у JBD ═══ -->
  <div class="app-shell">

    <!-- Ліва панель — Текст -->
    <aside class="settings-panel" id="left-panel">
      <h2>
        <span class="panel-title-text">Текст</span>
        <span class="panel-menu-icon" id="btn-collapse-left" title="Згорнути панель">☰</span>
      </h2>

      <div class="settings-block">
        <h3>Відступи<span class="settings-info-icon" title="Налаштування відступів тексту">ⓘ</span></h3>
        <label>
          Відступ дати
          <input type="range" id="oddDateX" min="0" max="40" step="0.1" value="0.5">
          <span id="oddDateXValue">0.5</span>
        </label>
        <label class="template-toggle">
          <input type="checkbox" id="dateOffsetRandomEnabled" checked>
          Випадковий відступ дати
        </label>
        <label>
          Відступ часу
          <input type="range" id="oddTimeX" min="0" max="40" step="0.1" value="0.5">
          <span id="oddTimeXValue">0.5</span>
        </label>
        <label class="template-toggle">
          <input type="checkbox" id="timeOffsetRandomEnabled" checked>
          Випадковий відступ часу
        </label>
        <label>
          Відступ середнього стовпчика
          <input type="range" id="oddTextX" min="0" max="80" step="0.1" value="0.5">
          <span id="oddTextXValue">0.5</span>
        </label>
      </div>

      <div class="settings-block">
        <h3>Рядки<span class="settings-info-icon" title="Налаштування положення тексту по рядкам">ⓘ</span></h3>
        <label>
          Верх першого рядка, мм
          <input type="range" id="firstRowTop" min="15" max="35" step="0.01" value="31.47">
          <span id="firstRowTopValue">31.47</span>
        </label>
        <label>
          Крок рядків, мм
          <input type="range" id="rowHeight" min="2.5" max="6.5" step="0.001" value="6.084">
          <span id="rowHeightValue">6.084</span>
        </label>
        <label>
          Відступ тексту від верху рядка, мм
          <input type="range" id="baselineOffset" min="3" max="9" step="0.01" value="6.07">
          <span id="baselineOffsetValue">6.07</span>
        </label>
      </div>

      <div class="settings-block">
        <h3>Початок генерації<span class="settings-info-icon" title="Вибір сторінки та номеру першого рядка">ⓘ</span></h3>
        <label>
          Починати з типу сторінки
          <select id="startPageNumber">
            <option value="1">1 — непарна</option>
            <option value="2">2 — парна</option>
          </select>
        </label>
        <label class="inline-number-label">
          Початковий рядок
          <input type="number" id="startRowNumber" class="inline-number-input" min="1" max="60" step="1" value="1">
        </label>
      </div>

      <div class="settings-block">
        <h3>Рукопис<span class="settings-info-icon" title="Налаштування відображення тексту">ⓘ</span></h3>
        <label>
          Набір шрифту для тексту
          <select id="handwritingFontPack">
            <option value="Litopys">Litopys</option>
          </select>
        </label>
        <div class="fontpack-actions">
          <button class="icon-only demo-locked" type="button" title="Додати шрифт" aria-label="Додати шрифт">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5v14"/></svg>
          </button>
          <button class="icon-only demo-locked" type="button" title="Видалити шрифт" aria-label="Видалити шрифт">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
          </button>
          <button class="icon-only demo-locked" type="button" title="Експорт шрифту" aria-label="Експорт шрифту">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </button>
          <button class="icon-only demo-locked" type="button" title="Імпорт шрифту" aria-label="Імпорт шрифту">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </button>
        </div>
        <label>
          Перенос рядків
          <select id="wrapMode">
            <option value="auto" selected>Автоматично за шириною колонки</option>
            <option value="manual">Вручну за кількістю символів</option>
          </select>
        </label>
        <label>
          Символів у рядку
          <input type="number" id="charLimit" min="20" max="200" step="1" value="50">
        </label>
        <label>
          Розмір дати/часу, pt
          <input type="range" id="dateFontSize" min="6" max="24" step="0.1" value="12">
          <span id="dateFontSizeValue">12</span>
        </label>
        <label>
          Розмір середнього тексту, pt
          <input type="range" id="textFontSize" min="6" max="24" step="0.1" value="12">
          <span id="textFontSizeValue">12</span>
        </label>
        <label>
          Розмір правого стовпчика, pt
          <input type="range" id="noteFontSize" min="6" max="24" step="0.1" value="12">
          <span id="noteFontSizeValue">12</span>
        </label>
        <label>
          Нахил літер, ±°
          <input type="range" id="letterRotate" min="0" max="15" step="0.1" value="0">
          <span id="letterRotateValue">0</span>
        </label>
        <label>
          Вертикальна випадковість, ±px/pt
          <input type="range" id="letterJitterY" min="0" max="3" step="0.1" value="0">
          <span id="letterJitterYValue">0</span>
        </label>
        <label>
          Ширина пробілу між словами
          <input type="range" id="spaceFactor" min="0" max="2.5" step="0.05" value="0.25">
          <span id="spaceFactorValue">0.25</span>
        </label>
        <label>
          Мікропробіли між символами, ±px/pt
          <input type="range" id="charMicroSpacing" min="0" max="2.5" step="0.05" value="0">
          <span id="charMicroSpacingValue">0</span>
        </label>
      </div>

      <div class="settings-block">
        <h3>Підписи<span class="settings-info-icon" title="Налаштування підписів для додавання в документ">ⓘ</span></h3>
        <label>
          Збережені підписи
          <select id="signatureLibrarySelect">
            <option value="">— немає збережених —</option>
          </select>
        </label>
        <div class="fontpack-actions">
          <button class="icon-only demo-locked" type="button" title="Імпортувати підпис" aria-label="Імпортувати підпис">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </button>
          <button class="icon-only demo-locked" type="button" title="Редагувати підпис" aria-label="Редагувати підпис">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 21h8"/><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/></svg>
          </button>
          <button class="icon-only demo-locked" type="button" title="Перейменувати підпис" aria-label="Перейменувати підпис">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
          </button>
          <button class="icon-only demo-locked" type="button" title="Видалити підпис" aria-label="Видалити підпис">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
          </button>
        </div>
      </div>

      <div class="settings-block">
        <h3>Налаштування<span class="settings-info-icon" title="Імпорт/експорт налаштувань тексту">ⓘ</span></h3>
        <div class="settings-actions">
          <button class="icon-only demo-locked" title="Зберегти налаштування" aria-label="Зберегти налаштування">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg>
          </button>
          <button class="icon-only demo-locked" title="Експорт профілю" aria-label="Експорт профілю">
