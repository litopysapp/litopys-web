---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    slug: 'litopys',
    name: 'Litopys',
    tagline: 'Ручка — зброя писаря',
    desc: 'Офлайн-редактор документів: готові журнали ЖБД і ЖОВтР або власний шаблон, з друком ручкою через плотер.',
    icon: '/icon-book-open-check.svg',
    cta: 'Перейти до Litopys',
    accent: '#2b4a8b',
  },
  {
    slug: 'litoscan',
    name: 'LitoScan',
    tagline: 'Сканування без клопоту',
    desc: 'Сканування, об’єднання та редагування PDF: дуплекс, обертання і видалення сторінок, пошук у тексті, друк.',
    icon: '/icon-scan-line.svg',
    cta: 'Перейти до LitoScan',
    accent: '#0f6b52',
  },
  {
    slug: 'litograph',
    name: 'LitoGraph',
    tagline: 'Твій почерк — шрифтом',
    desc: 'Створення рукописного шрифту зі сканів символів або малювання від руки — з редактором гліфів і збіркою шрифту.',
    icon: '/icon-case-sensitive.svg',
    cta: 'Перейти до LitoGraph',
    accent: '#7c3a8a',
  },
];
---
<Layout title="Litopys Suite — Litopys, LitoScan, LitoGraph" description="Три офлайн-застосунки для роботи з документами: Litopys, LitoScan і LitoGraph.">

  <!-- ══ HERO ══ -->
  <section class="hero-page">
    <div class="hero-bg"></div>
    <div class="container">
      <p class="eyebrow fade-up">Litopys Suite</p>
      <h1 class="fade-up" style="--d:.05s">Три застосунки.<br/>Один почерк.</h1>
      <p class="hero-sub fade-up" style="--d:.1s">Litopys, LitoScan і LitoGraph — офлайн-програми для Windows, які пишуть, сканують і копіюють твій почерк, поки ти цього не робиш.</p>
    </div>
  </section>

  <!-- ══ PRODUCTS ══ -->
  <section class="section-products">
    <div class="container">
      <div class="products-grid">
        {products.map((p, i) => (
          <a href={`/${p.slug}`} class="product-card fade-up" style={`--d:${i * 0.08}s; --accent:${p.accent}`}>
            <div class="product-icon-wrap"><img src={p.icon} alt="" class="product-svg" /></div>
            <p class="product-tagline">{p.tagline}</p>
            <h2>{p.name}</h2>
            <p class="product-desc">{p.desc}</p>
            <span class="product-cta">{p.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHY ══ -->
  <section class="section-why">
    <div class="container">
      <div class="why-grid">
        <div class="why-card fade-up">
          <div class="why-icon-wrap"><img src="/icon-globe-off.svg" alt="" class="why-svg" /></div>
          <p class="why-title">Повністю офлайн</p>
          <p class="why-desc">Жодних хмар. Усі файли — на вашому диску, під вашим контролем.</p>
        </div>
        <div class="why-card fade-up" style="--d:.08s">
          <div class="why-icon-wrap"><img src="/icon-sparkles.svg" alt="" class="why-svg" /></div>
          <p class="why-title">Один акаунт</p>
          <p class="why-desc">Один вхід Litopys для всіх трьох застосунків — без повторної реєстрації.</p>
        </div>
        <div class="why-card fade-up" style="--d:.16s">
          <div class="why-icon-wrap"><img src="/icon-pencil-sparkles.svg" alt="" class="why-svg" /></div>
          <p class="why-title">Зроблено в Україні</p>
          <p class="why-desc">Розробляється й підтримується українською командою.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-card fade-up">
        <p class="eyebrow cta-eyebrow">Готові спробувати?</p>
        <h2>Обери застосунок<br/>і почни зараз</h2>
        <p class="cta-sub">Litopys можна протестувати прямо в браузері — без реєстрації та завантажень.</p>
        <a href="/litopys/demo" class="btn-white">Відкрити демо Litopys →</a>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .fade-up {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .65s ease, transform .65s ease;
    transition-delay: var(--d, 0s);
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }
</style>

<style>
  .container { max-width: 1060px; margin: 0 auto; padding: 0 1.5rem; }
  .eyebrow {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #4f7cac;
    margin-bottom: 1rem;
  }

  /* ── Hero ── */
  .hero-page { position: relative; padding: 5rem 0 3.5rem; }
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 20% 40%, #dce8f5 0%, transparent 55%),
                radial-gradient(ellipse at 80% 60%, #f5ead8 0%, transparent 50%),
                #f8f9fb;
    pointer-events: none;
  }
  .hero-page h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1.08;
    margin-bottom: 1.25rem;
    color: #111827;
  }
  .hero-sub { font-size: 1.0625rem; color: #6b7280; line-height: 1.75; max-width: 620px; }

  /* ── Products ── */
  .section-products { padding: 1.5rem 0 5rem; }
  .products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .product-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,.85);
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 2.25rem;
    backdrop-filter: blur(8px);
    transition: box-shadow .2s, transform .2s, border-color .2s;
  }
  .product-card:hover {
    box-shadow: 0 16px 40px rgba(0,0,0,.09);
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .product-icon-wrap {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .product-svg { width: 24px; height: 24px; display: block; }
  .product-tagline {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .4rem;
  }
  .product-card h2 { font-size: 1.375rem; font-weight: 800; letter-spacing: -.02em; color: #111827; margin-bottom: .6rem; }
  .product-desc { font-size: .9375rem; color: #6b7280; line-height: 1.65; flex: 1; margin-bottom: 1.5rem; }
  .product-cta { font-size: .875rem; font-weight: 700; color: var(--accent); }

  /* ── Why ── */
  .section-why { padding: 2rem 0 6rem; }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .why-card {
    background: rgba(255,255,255,.7);
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 1.75rem;
    backdrop-filter: blur(8px);
  }
  .why-icon-wrap { width: 32px; height: 32px; margin-bottom: 1rem; }
  .why-svg { width: 28px; height: 28px; display: block; }
  .why-title { font-weight: 700; font-size: 1rem; margin-bottom: .4rem; color: #111827; }
  .why-desc { font-size: .875rem; color: #6b7280; line-height: 1.6; }

  /* ── Buttons ── */
  .btn-white {
    display: inline-block;
    background: #fff;
    color: #1a1a2e;
    padding: .85rem 2.2rem;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    transition: transform .2s, box-shadow .2s;
    box-shadow: 0 4px 20px rgba(0,0,0,.18);
  }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(0,0,0,.25); }

  /* ── CTA ── */
  .section-cta { padding: 0 0 8rem; }
  .cta-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    border-radius: 28px; padding: 5rem 3rem; text-align: center; color: #fff;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
    position: relative; overflow: hidden;
  }
  .cta-card::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,213,0,.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-card::after {
    content: '';
    position: absolute;
    bottom: -60px; left: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(0,91,187,.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-eyebrow { color: rgba(255,255,255,.5) !important; }
  .cta-card h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -.04em; line-height: 1.1; margin-bottom: 1rem;
    position: relative; z-index: 1;
  }
  .cta-sub { font-size: 1.0625rem; color: rgba(255,255,255,.7); margin-bottom: 2.5rem; line-height: 1.6; position: relative; z-index: 1; }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .products-grid { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .cta-card { padding: 3rem 1.5rem; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
