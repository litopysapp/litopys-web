---
import Layout from '../../layouts/Layout.astro';

const { user } = Astro.locals;
const token = Astro.cookies.get('litopys_token')?.value ?? '';

if (user?.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

let actionError = '';
let actionSuccess = '';

const STATUSES = ['Оформлено', 'В роботі', 'Виконано'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const orderId = form.get('orderId')?.toString();
  const status = form.get('status')?.toString();
  const downloadUrl = form.get('downloadUrl')?.toString() ?? '';

  if (orderId && status) {
    try {
      const res = await fetch(`https://api.litopys.win/admin/orders/${orderId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ status, downloadUrl }),
      });
      const data = await res.json();
      if (data.ok) {
        actionSuccess = 'Оновлено';
      } else {
        actionError = 'Не вдалося оновити замовлення';
      }
    } catch {
      actionError = 'Помилка зʼєднання';
    }
  }
}

let orders: any[] = [];
try {
  const res = await fetch('https://api.litopys.win/admin/orders', {
    headers: { Authorization: `Bearer ${token}` },
  });
  const data = await res.json();
  if (data.ok) orders = data.orders ?? [];
} catch {}

function fmtDate(d: string | null | undefined) {
  if (!d) return '—';
  return new Date(d).toLocaleString('uk-UA', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}

function fmtUAH(n: number) {
  return n.toLocaleString('uk-UA') + ' грн';
}
---

<Layout title="Замовлення — Адмін — Літопис" noHeader={true}>
  <div class="admin-wrap">
    <header class="admin-header">
      <h1>Замовлення</h1>
      <a href="/dashboard" class="back-link">← У кабінет</a>
    </header>

    {actionSuccess && <div class="alert-success">{actionSuccess}</div>}
    {actionError && <div class="alert-error">{actionError}</div>}

    {orders.length === 0 ? (
      <p class="no-data">Замовлень поки немає.</p>
    ) : (
      <div class="orders-table">
        {orders.map((o: any) => (
          <div class="order-row">
            <div class="order-main">
              <div class="order-top">
                <span class="order-number">№{o.orderNumber}</span>
                <span class="order-date">{fmtDate(o.createdAt)}</span>
              </div>
              <p class="order-client">{o.user.name} · {o.user.email} · {o.user.phone ?? '—'} · ID {o.user.id}</p>
              <ul class="order-items">
                {o.items.map((i: any) => (
                  <li><span>{i.name}</span><span>{fmtUAH(i.price * (i.qty || 1))}</span></li>
                ))}
              </ul>
              <p class="order-total">Разом: {fmtUAH(o.total)}</p>
              {o.comment && <p class="order-comment">Коментар: {o.comment}</p>}
            </div>

            <form method="POST" class="order-form">
              <input type="hidden" name="orderId" value={o.id} />
              <label>
                Статус
                <select name="status">
                  {STATUSES.map(s => <option value={s} selected={s === o.status}>{s}</option>)}
                </select>
              </label>
              <label>
                Посилання на шрифт
                <input type="url" name="downloadUrl" value={o.downloadUrl ?? ''} placeholder="https://..." />
              </label>
              <button type="submit" class="btn-save">Зберегти</button>
            </form>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .admin-wrap { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .admin-header h1 { font-size: 1.5rem; font-weight: 800; color: #111827; letter-spacing: -.02em; }
  .back-link { font-size: .875rem; color: #6b7280; font-weight: 600; }
  .back-link:hover { color: #111827; }

  .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; border-radius: 10px; padding: .65rem 1rem; font-size: .875rem; margin-bottom: 1rem; }
  .alert-error { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; border-radius: 10px; padding: .65rem 1rem; font-size: .875rem; margin-bottom: 1rem; }

  .no-data { color: #6b7280; font-size: .9375rem; }

  .orders-table { display: flex; flex-direction: column; gap: 1rem; }
  .order-row {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
  }

  .order-top { display: flex; align-items: baseline; gap: .75rem; margin-bottom: .35rem; }
  .order-number { font-size: 1rem; font-weight: 800; color: #111827; }
  .order-date { font-size: .8125rem; color: #9ca3af; }
  .order-client { font-size: .8125rem; color: #6b7280; margin-bottom: .75rem; }

  .order-items { list-style: none; display: flex; flex-direction: column; gap: .3rem; margin-bottom: .5rem; }
  .order-items li { display: flex; justify-content: space-between; font-size: .875rem; color: #4b5563; gap: 1rem; max-width: 320px; }
  .order-total { font-size: .9375rem; font-weight: 700; color: #111827; }
  .order-comment { font-size: .8125rem; color: #6b7280; margin-top: .5rem; }

  .order-form { display: flex; flex-direction: column; gap: .65rem; }
  .order-form label { display: flex; flex-direction: column; gap: .3rem; font-size: .75rem; font-weight: 600; color: #374151; }
  .order-form select, .order-form input {
    padding: .5rem .65rem;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    font-size: .8125rem;
    font-family: inherit;
    background: #fff;
    color: #111827;
  }
  .btn-save {
    margin-top: .25rem;
    background: #1a1a2e;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: .5rem;
    font-size: .8125rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .2s;
  }
  .btn-save:hover { opacity: .85; }

  @media (max-width: 640px) {
    .order-row { grid-template-columns: 1fr; }
  }
</style>
