---
import ArticleLayout from '../../components/ArticleLayout.astro';

// Лише шрифти, у яких перевірено всю українську абетку (ґ є і ї ʼ), під SIL OFL 1.1.
// Файли лежать у /fonts/free без змін.
const fonts = [
  { id: 'caveat', name: 'Caveat', file: 'Caveat.ttf', gf: 'Caveat', size: 2.1,
    text: 'Живий, трохи похилий почерк з округлими літерами. Найуніверсальніший: читається легко навіть дрібним кеглем, добре виглядає в зошиті й на листівці.',
    use: 'конспекти, нотатки, підписи до фото' },
  { id: 'badscript', name: 'Bad Script', file: 'BadScript-Regular.ttf', gf: 'Bad Script', size: 1.6,
    text: 'Тонкий швидкий прописний почерк, ніби писали гелевою ручкою на ходу. Літери з’єднані, з видимими розгонами.',
    use: 'листи, записки, оформлення меню' },
  { id: 'marck', name: 'Marck Script', file: 'MarckScript-Regular.ttf', gf: 'Marck Script', size: 1.8,
    text: 'Акуратний шкільний пропис з чіткими формами. Нагадує почерк старанного учня — розбірливий і рівний.',
    use: 'шкільні матеріали, вітання' },
  { id: 'neucha', name: 'Neucha', file: 'Neucha.ttf', gf: 'Neucha', size: 1.7,
    text: 'Друковані, не з’єднані літери, ніби написані маркером. Простий і дружній, без завитків.',
    use: 'плакати, дитячі матеріали, інфографіка' },
  { id: 'comforter', name: 'Comforter', file: 'Comforter-Regular.ttf', gf: 'Comforter', size: 2.1,
    text: 'Легкий розмашистий почерк пензлем або тонким маркером. Виразний, але все ще природний.',
    use: 'листівки, банери, заголовки' },
  { id: 'greatvibes', name: 'Great Vibes', file: 'GreatVibes-Regular.ttf', gf: 'Great Vibes', size: 2.1,
    text: 'Святкова каліграфія з довгими петлями. Це не повсякденний почерк, а «запрошення на весілля».',
    use: 'запрошення, сертифікати, логотипи' },
  { id: 'amatic', name: 'Amatic SC', file: 'AmaticSC-Regular.ttf', gf: 'Amatic SC', size: 2.1,
    text: 'Вузькі високі капітелі, ніби написані тонким фломастером. Малі літери — це зменшені великі, тому для довгого тексту він не підходить.',
    use: 'заголовки, вивіски, обкладинки' },
];
const fontFaces = fonts.map((f) => `@font-face{font-family:"free-${f.id}";src:url("/fonts/free/${f.file}") format("truetype");font-display:swap}`).join('\n');
---
<ArticleLayout
  slug="bezkoshtovni-rukopysni-shryfty"
  cta={{
    eyebrow: 'Безкоштовно',
    title: 'Спробуйте з власним текстом',
    text: 'Усі ці почерки є в генераторі рукописного тексту: введіть текст, оберіть ручку й папір і завантажте сторінку в PNG або PDF.',
    href: '/rukopysnyi-tekst-onlain',
    button: 'Відкрити генератор →',
  }}
>
  <Fragment set:html={`<style>${fontFaces}</style>`} />

  <p>Рукописних шрифтів в інтернеті тисячі, але з кирилицею — значно менше, а з повною <b>українською</b> абеткою ще менше. Часто в шрифті є «и» та «е», але немає «ґ», «є», «ї» чи апострофа, і замість них у тексті з’являються квадратики або літери з іншого шрифту.</p>
  <p>Ми перевірили кожен шрифт нижче: у всіх є повна українська абетка, великі й малі літери, ґ, є, і, ї та апостроф. Усі вони поширюються під вільною ліцензією SIL Open Font License, тож їх можна безкоштовно використовувати і в особистих, і в комерційних проєктах.</p>

  {fonts.map((f, i) => (
    <>
      <h2>{i + 1}. {f.name}</h2>
      <p class="font-sample" style={`font-family:"free-${f.id}",cursive;font-size:${f.size}rem`}>Ґанок, їжак і євшан-зілля — п’ять слів</p>
      <p>{f.text}</p>
      <p><b>Підходить для:</b> {f.use}. Завантажити — на <a href={`https://fonts.google.com/specimen/${f.gf.replace(/ /g, '+')}`} rel="noopener" target="_blank">Google Fonts</a>.</p>
    </>
  ))}

  <h2>Як обрати рукописний шрифт</h2>
  <ul>
    <li><b>Для довгого тексту</b> беріть спокійні почерки: Caveat, Marck Script, Neucha. Святкові шрифти на кшталт Great Vibes гарні в одному рядку й утомлюють на цілій сторінці.</li>
    <li><b>Перевірте всі літери.</b> Напишіть тестове речення з «ґ», «є», «ї» та апострофом — і одразу побачите, чи не підставляє система чужі літери.</li>
    <li><b>Не зменшуйте занадто.</b> Рукописні шрифти візуально дрібніші за звичайні: там, де Arial має 12 pt, рукописному потрібно 16–20 pt.</li>
  </ul>

  <h2>Чому навіть найкращий шрифт видно</h2>
  <p>Звичайний шрифт має по одному варіанту кожної літери. У тексті всі «а» однакові до пікселя, і око це помічає, хай і не одразу. У живому письмі двох однакових літер не буває.</p>
  <p>Тому шрифти для <a href="/litopys">Літопису</a> мають по кілька варіантів кожної літери, які чергуються в тексті. Обрати готовий почерк можна в <a href="/litopys/shrifty">каталозі шрифтів</a>, а створити з власного почерку — у <a href="/statti/yak-stvoryty-shryft-zi-svoho-pocherku">LitoGraph</a>. А якщо треба, щоб текст написала справжня ручка, — читайте, <a href="/statti/plotter-pyshe-ruchkoiu">як плотер пише ручкою</a>.</p>
</ArticleLayout>

<style>
  .font-sample { color: #1f3f9a; line-height: 1.35; margin: .25rem 0 .75rem; padding: .75rem 1rem; background: #fdfdf9; border: 1px solid #e5e7eb; border-radius: 12px; overflow-wrap: anywhere; }
</style>
