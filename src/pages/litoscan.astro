---
import Layout from '../layouts/Layout.astro';

const groups = [
  {
    icon: '/icon-scan-line.svg',
    title: 'Сканування',
    items: [
      { h: 'Дуплексне сканування', p: 'Скануй непарні сторінки, переверни стос — і LitoScan сам вставить парні на правильні місця в потрібному порядку.' },
      { h: 'Прогрес прямо під час сканування', p: 'Сторінки з’являються в списку одразу, як тільки скановані — не треба чекати завершення всього стосу.' },
    ],
  },
  {
    icon: '/icon-file-stack.svg',
    title: 'Робота зі сторінками',
    items: [
      { h: 'Об’єднання PDF', p: 'Збери кілька файлів в один документ у потрібному порядку.' },
      { h: 'Обертання і розворот', p: 'Поворот на 90°/180° для однієї сторінки чи всього документа, разом із розворотом порядку сторінок.' },
      { h: 'Витягти чи видалити сторінки', p: 'Виділи потрібні сторінки — виріж їх у новий PDF або видали з поточного.' },
    ],
  },
  {
    icon: '/icon-book-open-check.svg',
    title: 'Перегляд і пошук',
    items: [
      { h: 'Пошук по тексту документа', p: 'Ctrl+F шукає по всіх сторінках і підсвічує збіги прямо в тексті сканованого PDF.' },
      { h: 'Мініатюри сторінок', p: 'Швидка навігація списком мініатюр, з підказкою про оригінальний номер сторінки після перестановки.' },
    ],
  },
  {
    icon: '/icon-save-check.svg',
    title: 'Збереження і друк',
    items: [
      { h: 'Збереження PDF', p: 'Зберігай результат як новий файл або перезаписуй існуючий.' },
      { h: 'Друк документа', p: 'Друк прямо з програми — без проміжного відкриття в іншому переглядачі.' },
      { h: 'Захист від втрати змін', p: 'Попередження про незбережені зміни перед закриттям вікна.' },
    ],
  },
  {
    icon: '/icon-globe-off.svg',
    title: 'Дані й безпека',
    items: [
      { h: 'Локальна робота', p: 'Сканування й редагування відбуваються на твоєму ПК, без надсилання файлів на сервер.' },
      { h: 'Один акаунт Litopys', p: 'Той самий вхід, що й у Litopys та LitoGraph — реєструватись повторно не треба.' },
    ],
  },
];
---
<Layout title="LitoScan — сканування та редагування PDF" description="LitoScan: безкоштовна програма для сканування, об’єднання та редагування PDF-документів. Дуплексне сканування, пошук у тексті, друк.">

  <!-- ══ HERO ══ -->
  <section class="hero-page">
    <div class="hero-bg"></div>
    <div class="container">
      <p class="eyebrow fade-up">LitoScan</p>
      <h1 class="fade-up" style="--d:.05s">Сканування без клопоту.<br/>PDF без зайвих програм.</h1>
      <p class="hero-sub fade-up" style="--d:.1s">Безкоштовна програма для Windows: скануй документи, об’єднуй, редагуй і шукай текст у PDF — все офлайн, в одному вікні.</p>
      <div class="hero-cta fade-up" style="--d:.15s">
        <a href="https://api.litopys.win/download/litoscan" class="btn-primary">Завантажити безкоштовно →</a>
      </div>
    </div>
  </section>

  <!-- ══ FUNCTION GROUPS ══ -->
  <section class="section-groups">
    <div class="container">
      {groups.map((g, gi) => (
        <div class="fgroup fade-up" style={`--d:${Math.min(gi * 0.05, 0.3).toFixed(2)}s`}>
          <div class="fgroup-head">
            <div class="fgroup-icon-wrap"><img src={g.icon} alt="" class="fgroup-svg" /></div>
            <h2>{g.title}</h2>
          </div>
          <div class="fgroup-list">
            {g.items.map((it) => (
              <div class="fitem">
                <h3>{it.h}</h3>
                <p class="body-text">{it.p}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-card fade-up">
        <p class="eyebrow cta-eyebrow">Готові спробувати?</p>
        <h2>Завантажте LitoScan<br/>безкоштовно</h2>
        <p class="cta-sub">Для Windows, без реєстрації окремого акаунта — той самий вхід, що й у Litopys.</p>
        <a href="https://api.litopys.win/download/litoscan" class="btn-white">Завантажити →</a>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .fade-up {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .65s ease, transform .65s ease;
    transition-delay: var(--d, 0s);
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }
</style>

<style>
  .container { max-width: 1060px; margin: 0 auto; padding: 0 1.5rem; }
  .eyebrow {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #0f6b52;
    margin-bottom: 1rem;
  }
  .body-text { color: #4b5563; line-height: 1.75; font-size: .9375rem; }

  /* ── Hero ── */
  .hero-page { position: relative; padding: 6rem 0 3rem; }
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 20% 40%, #dcf0e8 0%, transparent 55%),
                radial-gradient(ellipse at 80% 60%, #f5ead8 0%, transparent 50%),
                #f8f9fb;
    pointer-events: none;
  }
  .hero-page h1 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1.12;
    color: #111827;
    margin-bottom: 1.25rem;
    max-width: 760px;
  }
  .hero-sub { font-size: 1.0625rem; color: #6b7280; line-height: 1.75; max-width: 620px; margin-bottom: 2rem; }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    display: inline-block;
    background: #0f6b52;
    color: #fff;
    padding: .8rem 1.9rem;
    border-radius: 50px;
    font-size: .9375rem;
    font-weight: 600;
    transition: opacity .2s, transform .2s, box-shadow .2s;
    box-shadow: 0 4px 16px rgba(15,107,82,.25);
  }
  .btn-primary:hover { opacity: .85; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,107,82,.3); }

  /* ── Groups ── */
  .section-groups { padding: 3rem 0 7rem; }
  .fgroup {
    background: rgba(255,255,255,.85);
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 2.25rem 2.5rem 2.5rem;
    backdrop-filter: blur(8px);
    transition: box-shadow .2s, border-color .2s;
  }
  .fgroup:hover { box-shadow: 0 12px 32px rgba(0,0,0,.06); border-color: #a8d5c5; }
  .fgroup + .fgroup { margin-top: 1.5rem; }
  .fgroup-head { display: flex; align-items: center; gap: .9rem; margin-bottom: 1.5rem; }
  .fgroup-icon-wrap {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: #e9f5f0;
    color: #0f6b52;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .fgroup-svg { width: 22px; height: 22px; display: block; }
  .fgroup-head h2 { font-size: 1.375rem; font-weight: 800; letter-spacing: -.02em; color: #111827; }

  .fgroup-list { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; }
  .fitem h3 { font-size: 1rem; font-weight: 700; color: #111827; margin-bottom: .4rem; letter-spacing: -.005em; }

  @media (max-width: 700px) {
    .fgroup { padding: 1.75rem 1.5rem 2rem; }
    .fgroup-list { grid-template-columns: 1fr; gap: 1.25rem; }
  }

  /* ── CTA ── */
  .section-cta { padding: 3rem 0 8rem; }
  .cta-card {
    background: linear-gradient(135deg, #0b3d30 0%, #0f6b52 60%, #14895f 100%);
    border-radius: 28px; padding: 5rem 3rem; text-align: center; color: #fff;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
    position: relative; overflow: hidden;
  }
  .cta-card::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,255,255,.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-card::after {
    content: '';
    position: absolute;
    bottom: -60px; left: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(0,0,0,.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-eyebrow { color: rgba(255,255,255,.6) !important; }
  .cta-card h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -.04em; line-height: 1.1; margin-bottom: 1rem;
    position: relative; z-index: 1;
  }
  .cta-sub { font-size: 1.0625rem; color: rgba(255,255,255,.75); margin-bottom: 2.5rem; line-height: 1.6; position: relative; z-index: 1; }
  .btn-white {
    display: inline-block;
    background: #fff;
    color: #0f6b52;
    padding: .85rem 2.2rem;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    transition: transform .2s, box-shadow .2s;
    box-shadow: 0 4px 20px rgba(0,0,0,.18);
    position: relative; z-index: 1;
  }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(0,0,0,.25); }
  @media (max-width: 640px) {
    .cta-card { padding: 3rem 1.5rem; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
