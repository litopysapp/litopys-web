---
import Layout from '../layouts/Layout.astro';

const fonts = [
  { name: 'Litopys-1', preview: '/font-previews/Litopys-1.gif' },
  { name: 'Litopys-2', preview: '/font-previews/Litopys-2.gif' },
  { name: 'Litopys-3', preview: '/font-previews/Litopys-3.gif' },
  { name: 'Litopys-4', preview: '/font-previews/Litopys-4.gif' },
];
---
<Layout title="Шрифти — Літопис" description="Готові рукописні шрифти для Літопису — обери й перевір, як виглядає.">

  <!-- ══ HERO ══ -->
  <section class="hero-page">
    <div class="hero-bg"></div>
    <div class="container">
      <p class="eyebrow fade-up">Шрифти</p>
      <h1 class="fade-up" style="--d:.05s">Обери готовий почерк<br/>для Літопису.</h1>
      <p class="hero-sub fade-up" style="--d:.1s">Кілька рукописних варіантів на вибір. Не підійшло жодне — замов індивідуальний зі свого почерку.</p>
    </div>
  </section>

  <!-- ══ CATALOG ══ -->
  <section class="section-catalog">
    <div class="container">
      <div class="fonts-grid">
        {fonts.map((f, i) => (
          <div class="font-card fade-up" style={`--d:${(i * 0.08).toFixed(2)}s`}>
            <div class="font-preview">
              <img src={f.preview} alt={`Зразок почерку: ${f.name}`} class="font-preview-img" draggable="false" />
            </div>
            <div class="font-footer">
              <p class="font-name">{f.name}</p>
              <p class="font-price">5 000 <span class="plan-currency">грн</span></p>
              <button class="btn-primary" data-add-to-cart data-id={`font-${f.name.toLowerCase()}`} data-name={`Шрифт ${f.name}`} data-price="5000">Купити →</button>
            </div>
          </div>
        ))}
      </div>

      <p class="catalog-note fade-up">Не знайшли підходящий почерк? <a href="/tsiny">Замовте індивідуальний шрифт</a> зі свого власного.</p>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-card fade-up">
        <p class="eyebrow cta-eyebrow">Готові спробувати?</p>
        <h2>Відкрийте Літопис<br/>прямо зараз</h2>
        <p class="cta-sub">Протестуйте редактор у браузері — без реєстрації та завантажень.</p>
        <a href="/demo" class="btn-white">Відкрити демо →</a>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .fade-up {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .65s ease, transform .65s ease;
    transition-delay: var(--d, 0s);
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }
</style>

<style>
  .container { max-width: 1060px; margin: 0 auto; padding: 0 1.5rem; }
  .eyebrow {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #4f7cac;
    margin-bottom: 1rem;
  }

  /* ── Hero ── */
  .hero-page { position: relative; padding: 6rem 0 3rem; }
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 20% 40%, #dce8f5 0%, transparent 55%),
                radial-gradient(ellipse at 80% 60%, #f5ead8 0%, transparent 50%),
                #f8f9fb;
    pointer-events: none;
  }
  .hero-page h1 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1.12;
    color: #111827;
    margin-bottom: 1.25rem;
    max-width: 760px;
  }
  .hero-sub { font-size: 1.0625rem; color: #6b7280; line-height: 1.75; max-width: 620px; }

  /* ── Catalog ── */
  .section-catalog { padding: 3rem 0 5rem; }
  .fonts-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .font-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,.85);
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0,0,0,.05);
    transition: box-shadow .2s, transform .2s, border-color .2s;
  }
  .font-card:hover { box-shadow: 0 16px 40px rgba(0,0,0,.1); transform: translateY(-3px); border-color: #bfd4e8; }

  .font-preview {
    position: relative;
    background: #fff;
    border-radius: 14px;
    padding: 2.25rem 2rem 1.75rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    box-shadow: 0 1px 2px rgba(0,0,0,.04), inset 0 0 0 1px #ececef;
    overflow: hidden;
  }
  .font-preview::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: linear-gradient(90deg, #005BBB 50%, #FFD500 50%);
  }
  .font-preview-img {
    max-width: 100%;
    width: 100%;
    height: auto;
    pointer-events: none;
    -webkit-user-drag: none;
    filter: contrast(1.08);
  }

  .font-footer { display: flex; align-items: center; gap: 1.5rem; padding: 0 .5rem; }
  .font-name { font-size: 1.125rem; font-weight: 700; color: #111827; letter-spacing: -.01em; flex: 1; }
  .font-price { font-size: 1.375rem; font-weight: 800; color: #111827; letter-spacing: -.02em; white-space: nowrap; }
  .plan-currency { font-size: .9rem; font-weight: 600; color: #6b7280; }

  .catalog-note { text-align: center; color: #9ca3af; font-size: .875rem; margin-top: 2.5rem; }
  .catalog-note a { text-decoration: underline; color: #6b7280; }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-block;
    background: #1a1a2e;
    color: #fff;
    padding: .8rem 1.9rem;
    border-radius: 50px;
    font-size: .9375rem;
    font-weight: 600;
    text-align: center;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .2s, transform .2s, box-shadow .2s;
    box-shadow: 0 4px 16px rgba(0,0,0,.2);
  }
  .btn-primary:hover { opacity: .85; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.25); }
  .btn-added { opacity: .6 !important; cursor: default !important; transform: none !important; }
  .btn-white {
    display: inline-block;
    background: #fff;
    color: #1a1a2e;
    padding: .85rem 2.2rem;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    transition: transform .2s, box-shadow .2s;
    box-shadow: 0 4px 20px rgba(0,0,0,.18);
  }
  .btn-white:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(0,0,0,.25); }

  /* ── CTA ── */
  .section-cta { padding: 3rem 0 8rem; }
  .cta-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    border-radius: 28px; padding: 5rem 3rem; text-align: center; color: #fff;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
    position: relative; overflow: hidden;
  }
  .cta-card::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,213,0,.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-card::after {
    content: '';
    position: absolute;
    bottom: -60px; left: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(0,91,187,.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-eyebrow { color: rgba(255,255,255,.5) !important; }
  .cta-card h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800; letter-spacing: -.04em; line-height: 1.1; margin-bottom: 1rem;
    position: relative; z-index: 1;
  }
  .cta-sub { font-size: 1.0625rem; color: rgba(255,255,255,.7); margin-bottom: 2.5rem; line-height: 1.6; position: relative; z-index: 1; }

  @media (max-width: 900px) {
    .fonts-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .cta-card { padding: 3rem 1.5rem; }
    .font-footer { flex-wrap: wrap; }
    .font-footer .btn-primary { width: 100%; text-align: center; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cart = (window as any).LitopysCart;
      if (!cart) return;
      cart.addToCart({
        id: btn.dataset.id!,
        name: btn.dataset.name!,
        price: Number(btn.dataset.price),
        qty: 1,
      });
      const original = btn.textContent;
      btn.textContent = 'Додано ✓';
      btn.classList.add('btn-added');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('btn-added');
      }, 1400);
    });
  });
</script>
