---
import Layout from '../layouts/Layout.astro';
import { PARTNERS } from '../lib/partners';

// Той самий текст — на litograph.pro/staty-partnerom/ (D:\LitoGraph\site\build.js).
const GETS = [
  { t: 'Картка на сторінці «Партнери»', d: 'На litopys.pro і litograph.pro — з описом проєкту, темами й посиланням на ваш сайт.' },
  { t: 'Місце в каруселі на головних', d: 'Ваша картка — на головних сторінках обох сайтів, поруч з іншими партнерами.' },
  { t: 'Плашка з вашим логотипом', d: 'Невелика плашка в кутку сайтів у ваших кольорах. Показується по черзі з іншими партнерами й легко закривається — відвідувачів не дратує.' },
  { t: 'Оформлення у вашому стилі', d: 'Логотип і фірмові кольори — ми самі підготуємо картку й плашку, від вас лише адреса сайту.' },
];
const WHO = [
  'Інформаційні проєкти й довідники для військовослужбовців та їхніх родин',
  'Корисні українські сервіси для щоденного життя й роботи',
  'Медіа, блоги й спільноти, читачам яких знадобиться Літопис чи рукописні шрифти',
];
const STEPS = [
  { t: 'Напишіть нам', d: 'Адреса сайту й кілька слів про проєкт — у листі, WhatsApp чи телефоном.' },
  { t: 'Погодимо формат', d: 'Що розміщуємо в нас і як ви згадаєте Літопис у себе.' },
  { t: 'Додаємо вас', d: 'Картка, місце в каруселі й плашка з’являються на обох сайтах.' },
];
const mail = 'mailto:info@litopys.pro?subject=' + encodeURIComponent('Партнерство з Літописом');
---
<Layout
  title="Стати партнером Літопису та LitoGraph"
  description="Розкажемо про ваш проєкт користувачам litopys.pro і litograph.pro: картка на сторінці партнерів, місце в каруселі на головних і плашка з вашим логотипом. Як стати партнером."
  breadcrumbs={[{ name: 'Партнери', path: '/partnery' }, { name: 'Стати партнером', path: '/staty-partnerom' }]}
>
  <div class="list-bg"></div>
  <section class="list">
    <p class="eyebrow">Партнерство</p>
    <h1>Станьте партнером Літопису</h1>
    <p class="lead">Ми розповідаємо користувачам Літопису й LitoGraph про корисні українські проєкти. Якщо ваш сайт чи сервіс допомагає людям — давайте співпрацювати.</p>
    <div class="actions">
      <a class="btn" href={mail}>Написати на info@litopys.pro</a>
      <a class="btn btn-ghost" href="https://wa.me/380930582908" target="_blank" rel="noopener">WhatsApp</a>
    </div>

    <h2>Що отримує партнер</h2>
    <div class="grid">
      {GETS.map((g) => (
        <div class="item"><b>{g.t}</b><p>{g.d}</p></div>
      ))}
    </div>

    <div class="two">
      <div>
        <h2>Кого ми шукаємо</h2>
        <ul class="who">{WHO.map((w) => <li>{w}</li>)}</ul>
      </div>
      <div>
        <h2>Як це працює</h2>
        <ol class="steps">
          {STEPS.map((s) => (<li><b>{s.t}</b><span>{s.d}</span></li>))}
        </ol>
      </div>
    </div>

    <div class="contact">
      <div>
        <h2>Напишіть нам</h2>
        <p>Email <a href={mail}>info@litopys.pro</a> · телефон <a href="tel:+380930582908">+380 93 058 2908</a> · <a href="https://wa.me/380930582908" target="_blank" rel="noopener">WhatsApp</a></p>
      </div>
      <a class="btn btn-light" href={mail}>Запропонувати партнерство</a>
    </div>

    <p class="already">Уже з нами: {PARTNERS.map((p, i) => (<>{i > 0 && ', '}<a href={p.url} target="_blank" rel="noopener">{p.name}</a></>))}. <a href="/partnery">Усі партнери →</a></p>
  </section>
</Layout>

<style>
  .list-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse at 20% 30%, #dce8f5 0%, transparent 55%), radial-gradient(ellipse at 85% 70%, #f5ead8 0%, transparent 50%), #f8f9fb;
  }
  .list { max-width: 980px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  .eyebrow { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #4f7cac; margin-bottom: .75rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.12; color: #111827; margin-bottom: 1rem; max-width: 720px; }
  h2 { font-size: 1.35rem; font-weight: 800; letter-spacing: -.02em; color: #111827; margin: 3rem 0 1.25rem; }
  .lead { color: #4b5563; line-height: 1.7; font-size: 1.0625rem; max-width: 660px; }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .btn { display: inline-block; background: #1a1a2e; color: #fff; padding: .8rem 1.6rem; border-radius: 50px; font-weight: 700; font-size: .9375rem; transition: transform .2s, box-shadow .2s; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.15); }
  .btn-ghost { background: transparent; color: #1a1a2e; border: 1.5px solid #1a1a2e; }
  .btn-light { background: #fff; color: #1a1a2e; flex-shrink: 0; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .item { background: rgba(255,255,255,.9); border: 1px solid #e5e7eb; border-radius: 18px; padding: 1.4rem 1.6rem; }
  .item b { display: block; font-size: 1.02rem; color: #111827; margin-bottom: .4rem; }
  .item p { color: #4b5563; line-height: 1.6; font-size: .9375rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .two > div { min-width: 0; }
  .who { list-style: none; display: flex; flex-direction: column; gap: .75rem; }
  .who li { position: relative; padding-left: 1.6rem; color: #374151; line-height: 1.6; }
  .who li::before { content: '✓'; position: absolute; left: 0; font-weight: 800; color: #0f6b52; }
  .steps { list-style: none; counter-reset: s; display: flex; flex-direction: column; gap: 1rem; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 2rem 1fr; column-gap: .9rem; }
  .steps li::before { content: counter(s); grid-row: span 2; width: 2rem; height: 2rem; border-radius: 50%; background: #1a1a2e; color: #fff; display: grid; place-items: center; font-weight: 700; font-size: .9rem; }
  .steps b { color: #111827; }
  .steps span { color: #4b5563; line-height: 1.6; font-size: .9375rem; }
  .contact {
    margin-top: 3.5rem; padding: 2rem 2.25rem; border-radius: 24px; color: #fff;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
  }
  .contact h2 { color: #fff; margin: 0 0 .5rem; }
  .contact p { color: rgba(255,255,255,.78); line-height: 1.7; }
  .contact a:not(.btn) { color: #fff; text-decoration: underline; }
  .already { margin-top: 2rem; color: #6b7280; font-size: .9rem; }
  .already a { color: #111827; text-decoration: underline; }
  @media (max-width: 760px) {
    .grid, .two { grid-template-columns: 1fr; }
    .two { gap: 0; }
    .list { padding: 2.5rem 1rem 4rem; }
    .contact { padding: 1.5rem; }
  }
</style>
