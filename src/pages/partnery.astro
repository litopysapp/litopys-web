---
import Layout from '../layouts/Layout.astro';
import { PARTNERS, markBg } from '../lib/partners';

const description = `Партнери Літопису та LitoGraph: ${PARTNERS.map((p) => `${p.name} (${p.domain})`).join(', ')}. Проєкти, яким ми довіряємо й радимо.`;
const itemList = {
  '@type': 'ItemList',
  name: 'Партнери Літопису',
  itemListElement: PARTNERS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: p.url })),
};
---
<Layout title="Партнери Літопису та LitoGraph" description={description} breadcrumbs={[{ name: 'Партнери', path: '/partnery' }]} jsonLd={[itemList]}>
  <div class="list-bg"></div>
  <section class="list">
    <p class="eyebrow">Партнери</p>
    <h1>Проєкти, з якими ми співпрацюємо</h1>
    <p class="lead">Ми радимо їх так само, як радимо Літопис. Той самий список — на <a href="https://litograph.pro/partnery/">litograph.pro</a>.</p>
    <div class="grid">
      {PARTNERS.map((p) => (
        <article class="item">
          <div class="head">
            <span class="mark" aria-hidden="true" style={`background:${markBg(p)}`}><img src={p.icon} alt="" width="28" height="33" /></span>
            <div>
              <h2>{p.name}</h2>
              <a class="domain" href={p.url} target="_blank" rel="noopener">{p.domain}</a>
            </div>
          </div>
          <p>{p.about}</p>
          <ul class="topics">{p.topics.map((t) => <li>{t}</li>)}</ul>
          <a class="more" href={p.url} target="_blank" rel="noopener">Перейти на {p.domain} →</a>
        </article>
      ))}
    </div>
    <a class="join-card" href="/staty-partnerom">
      <b>Хочете стати партнером?</b>
      <span>Розкажемо про ваш проєкт на обох сайтах — умови й контакти →</span>
    </a>
  </section>
</Layout>

<style>
  .list-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(40% 40% at 25% 20%, rgba(91,120,255,.16), transparent 70%), radial-gradient(32% 32% at 80% 55%, rgba(244,199,22,.08), transparent 70%);
  }
  .list { max-width: 980px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  .eyebrow { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--yellow); margin-bottom: .75rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.12; color: var(--text); margin-bottom: 1rem; max-width: 720px; }
  .lead { color: var(--text2); line-height: 1.65; margin-bottom: 2rem; max-width: 640px; }
  .lead a { color: var(--yellow); text-decoration: underline; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .item {
    display: flex; flex-direction: column; gap: .75rem; background: var(--glass); border: 1px solid var(--line);
    border-radius: 20px; padding: 1.5rem 1.75rem;
  }
  .head { display: flex; align-items: center; gap: .9rem; }
  .mark {
    width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0; display: grid; place-items: center;
    background: #f7f6f1; border: 1px solid var(--line);
  }
  .mark img { width: 28px; height: auto; }
  .item h2 { font-size: 1.3rem; font-weight: 800; letter-spacing: -.015em; color: var(--text); line-height: 1.2; }
  .domain { font-weight: 700; color: var(--yellow); font-size: .9rem; }
  .item p { color: var(--text2); line-height: 1.65; font-size: .9375rem; }
  .topics { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem; }
  .topics li { padding: .25rem .7rem; border-radius: 999px; background: rgba(91,120,255,.10); color: #5b2466; font-size: .8125rem; font-weight: 600; }
  .more { font-weight: 700; color: var(--yellow); font-size: .9rem; margin-top: auto; }
  .more:hover, .domain:hover { text-decoration: underline; }
  .join-card {
    margin-top: 1.25rem; display: flex; flex-direction: column; gap: .3rem; padding: 1.4rem 1.75rem; border-radius: 20px;
    background: linear-gradient(140deg, rgba(244,199,22,.14), rgba(91,120,255,.08) 60%, rgba(255,255,255,.03)); color: #fff; transition: transform .2s, box-shadow .2s;
  }
  .join-card:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,0,0,.15); }
  .join-card b { font-size: 1.1rem; }
  .join-card span { color: rgba(255,255,255,.75); font-size: .9375rem; }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
    .list { padding: 2.5rem 1rem 4rem; }
  }
</style>
