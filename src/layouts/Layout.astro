  html[data-promo="on"] .promo-off { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .hw { font-family: var(--f-hand); font-weight: 700; color: var(--yellow); letter-spacing: 0; }
  /* Іконки-SVG у <img> малюються чорним (currentColor) — на темному фоні фарбуємо їх у жовтий,
