  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: .8rem; color: var(--text-tertiary); }

  /* ---- Банер cookie ---- */
  .cookie-banner { position: fixed; left: 1rem; right: 1rem; bottom: calc(1rem + env(safe-area-inset-bottom, 0px)); z-index: 300; max-width: 640px; margin: 0 auto; background: rgba(16,18,44,.96); border: 1px solid var(--line2); color: var(--text); border-radius: 20px; padding: 1rem 1.25rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; box-shadow: 0 20px 60px rgba(0,0,0,.5); backdrop-filter: blur(16px); animation: cookieFadeIn .3s ease; }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner-text { flex: 1 1 320px; font-size: .84rem; line-height: 1.5; color: var(--text2); }
  .cookie-banner-btn { flex-shrink: 0; background: var(--yellow); color: #0b0c1d; border: none; border-radius: 999px; padding: .6rem 1.3rem; font-size: .84rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: background .15s; }
  .cookie-banner-btn:hover { background: var(--yellow2); }
  @keyframes cookieFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .nav-dropdown, .cookie-banner { animation: none; } }
</style>

<script>
  // Fetch latest GitHub release assets and wire up download links
  (async () => {
    const FALLBACK = 'https://github.com/litopysapp/litopys_release/releases/latest';
    try {
      const res = await fetch('https://api.github.com/repos/litopysapp/litopys_release/releases/latest', {
        headers: { 'Accept': 'application/vnd.github+json' }
      });
      if (res.ok) {
        const data = await res.json();
        const assets: { name: string; browser_download_url: string }[] = data.assets ?? [];
        const setup = assets.find((a: any) => a.name.includes('x64'))?.browser_download_url ?? FALLBACK;
        const portable = assets.find((a: any) => a.name.includes('Portable'))?.browser_download_url ?? FALLBACK;
        // nav dropdown
        const ns = document.getElementById('nav-dl-setup');
        const np = document.getElementById('nav-dl-portable');
        if (ns) ns.href = setup;
        if (np) np.href = portable;
        // hero dropdown (index page)
        const hs = document.getElementById('hero-dl-setup');
        const hp = document.getElementById('hero-dl-portable');
        if (hs) hs.href = setup;
        if (hp) hp.href = portable;
      }
    } catch {}
  })();

  const productsBtn = document.getElementById('products-btn');
  const productsMenu = document.getElementById('products-menu');
  if (productsBtn && productsMenu) {
    productsBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = productsMenu.classList.toggle('open');
      productsBtn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', () => {
      productsMenu.classList.remove('open');
      productsBtn.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        productsMenu.classList.remove('open');
        productsBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // _v2 — текст змінився (додано Google Analytics): показати ще раз.
  const COOKIE_NOTICE_KEY = 'litopys_cookie_notice_seen_v2';
  const cookieBanner = document.getElementById('cookie-banner');
  const cookieBannerOk = document.getElementById('cookie-banner-ok');
  if (cookieBanner && !localStorage.getItem(COOKIE_NOTICE_KEY)) {
    cookieBanner.hidden = false;
  }
  cookieBannerOk?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_NOTICE_KEY, '1');
    if (cookieBanner) cookieBanner.hidden = true;
  });
</script>
