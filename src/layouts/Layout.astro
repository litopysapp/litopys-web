  img[src^="/icon-"] { filter: invert(78%) sepia(83%) saturate(749%) hue-rotate(359deg) brightness(101%) contrast(92%); }
  [class*="btn-primary"] img[src^="/icon-"], .btn-download img[src^="/icon-"], .btn-y img[src^="/icon-"] { filter: none; }

