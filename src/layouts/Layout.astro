  .site-footer { border-top: 1px solid var(--line); margin-top: 64px; padding: 48px max(20px, env(safe-area-inset-left, 0px)) calc(32px + env(safe-area-inset-bottom, 0px)); color: var(--muted); font-size: .86rem; }
  .footer-in { max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 26px; }
