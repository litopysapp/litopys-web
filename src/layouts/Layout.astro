  .site-nav { display: flex; align-items: center; gap: 12px; height: var(--nav-h); padding: 0 8px 0 10px; border-radius: 999px; background: rgba(13,15,39,.66); border: 1px solid var(--line); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font: 700 1.15rem/1 var(--f-disp); letter-spacing: -.04em; color: var(--text); white-space: nowrap; }
  .brand .brand-badge { width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--line2); }
  .brand .brand-word { height: 28px; width: auto; display: block; }
