  .site-nav-links { display: flex; align-items: center; gap: 2px; margin-left: auto; }
  .nav-link { display: inline-flex; align-items: center; gap: 6px; padding: 9px 13px; border-radius: 999px; border: 0; background: transparent; color: var(--muted); font: 500 .9rem var(--f-body); cursor: pointer; white-space: nowrap; transition: color .2s, background .2s; }
  .nav-link:hover, .nav-products-btn[aria-expanded="true"] { color: var(--text); background: var(--glass); }
  .nav-icons { display: flex; gap: 6px; }
