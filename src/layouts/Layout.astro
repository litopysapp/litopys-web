  .nav-icon-btn:hover { background: var(--glass2); border-color: var(--line2); }
  .nav-icon-btn svg { width: 18px; height: 18px; }
  .cart-badge { position: absolute; top: -3px; right: -3px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: var(--yellow); color: #0b0c1d; font-size: .66rem; font-weight: 700; align-items: center; justify-content: center; line-height: 1; }
  .nav-cta { display: inline-flex; align-items: center; height: 42px; padding: 0 18px; border-radius: 999px; background: var(--yellow); color: #0b0c1d; font: 600 .9rem var(--f-body); white-space: nowrap; box-shadow: 0 8px 30px -10px rgba(244,199,22,.6); transition: transform .2s, background .2s; }
  .nav-cta:hover { background: var(--yellow2); transform: translateY(-1px); }
  .nav-download-wrap { position: relative; }
  .nav-dropdown { display: none; position: absolute; top: calc(100% + 10px); left: 0; min-width: 220px; padding: 6px; border-radius: 18px; background: rgba(16,18,44,.96); border: 1px solid var(--line2); box-shadow: 0 24px 60px rgba(0,0,0,.5); backdrop-filter: blur(18px); z-index: 200; animation: ddFade .14s ease; }
  .nav-dropdown.open { display: block; }
  @keyframes ddFade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .nav-dropdown-item { display: block; padding: .62rem .9rem; border-radius: 12px; font-size: .9rem; font-weight: 500; color: var(--text); white-space: nowrap; transition: background .12s; }
