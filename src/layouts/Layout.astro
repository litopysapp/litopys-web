---
interface Props {
  title: string;
  description?: string;
  fullPage?: boolean;
  noHeader?: boolean;
}
const { title, description = "Літопис — редактор документів для людей, яким важлива зручність", fullPage = false, noHeader = false } = Astro.props;

---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <script src="/cart.js" is:inline></script>
    <style is:global>
      @font-face {
        font-family: 'e-Ukraine';
        src: url('/fonts/e-UkraineHead-Thin.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --text: #1d1d1f;
        --text-secondary: #6e6e73;
        --text-tertiary: #aeaeb2;
        --border: #d2d2d7;
        --border-subtle: #e8e8ed;
        --bg: #ffffff;
        --bg-subtle: #f5f5f7;
        --bg-card: #fbfbfd;
        --surface: #f5f5f7;
        --radius-sm: 8px;
        --radius: 12px;
        --radius-lg: 18px;
        --nav-h: 52px;
      }
      html {
        font-family: 'e-Ukraine', -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
        color: var(--text);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      body { min-height: 100vh; display: flex; flex-direction: column; }
      body.full-page { height: 100vh; overflow: hidden; }
      body.full-page main { overflow: hidden; min-height: 0; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      button { font-family: inherit; }
    </style>
  </head>
  <body class:list={[fullPage && 'full-page']}>
    {!fullPage && !noHeader && (
      <header style="position:sticky; top:0; z-index:100; background:rgba(255,255,255,0.85); backdrop-filter:saturate(180%) blur(20px); -webkit-backdrop-filter:saturate(180%) blur(20px); border-bottom:1px solid var(--border-subtle);">
        <nav style="max-width:980px; margin:0 auto; height:var(--nav-h); padding:0 1.5rem; display:flex; align-items:center; justify-content:space-between;">
          <a href="/"><img src="/litopys-badge.png" alt="Літопис" style="height:36px;width:36px;object-fit:contain;border-radius:8px;display:block;"></a>
          <div style="display:flex; gap:1.5rem; align-items:center; font-size:.875rem; font-weight:400; color:var(--text-secondary);">
            <a href="/yak-pratsyuye">Як це працює</a>
            <a href="/shcho-potribno">Що потрібно</a>
            <a href="/tsiny">Ціни</a>
            <a href="/demo" style="color:var(--text);">ДЕМО</a>
            <div class="nav-download-wrap">
              <button class="nav-icon-btn" id="dl-btn" aria-label="Завантажити" aria-expanded="false" aria-haspopup="true">
                <img src="/icon-download-header.svg" alt="" style="width:18px;height:18px;display:block;" />
              </button>
              <div class="nav-dropdown" id="dl-menu" role="menu">
                <a href="https://api.litopys.win/download/setup" class="nav-dropdown-item" role="menuitem">Litopys</a>
                <a href="https://api.litopys.win/download/portable" class="nav-dropdown-item" role="menuitem">Litopys Portable</a>
              </div>
            </div>
            <a href="/dashboard" class="nav-icon-btn" aria-label="Кабінет">
              <img src="/icon-user-header.svg" alt="" style="width:18px;height:18px;display:block;" />
            </a>
            <a href="/koshyk" class="nav-icon-btn" aria-label="Кошик" style="position:relative;">
              <img src="/icon-cart.svg" alt="" style="width:18px;height:18px;display:block;" />
              <span id="cart-badge" style="display:none; position:absolute; top:2px; right:2px; min-width:15px; height:15px; padding:0 3px; border-radius:8px; background:#1a1a2e; color:#fff; font-size:.625rem; font-weight:700; align-items:center; justify-content:center; line-height:1;"></span>
            </a>
          </div>
        </nav>
      </header>
    )}
    <main style="flex:1;">
      <slot />
    </main>
    {!fullPage && (
      <footer style="border-top:1px solid var(--border-subtle); padding:2.5rem 1.5rem; color:var(--text-secondary); font-size:.8rem;">
        <div style="max-width:980px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem;">
          <div class="footer-contacts">
            <a href="mailto:info@litopys.pro" class="footer-contact-link" aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
              <span>info@litopys.pro</span>
            </a>
            <a href="https://wa.me/380930582908" target="_blank" rel="noopener" class="footer-contact-link" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2C6.486 2 2.01 6.477 2.01 11.994c0 2.115.679 4.073 1.833 5.671L2.6 22l4.451-1.223a9.955 9.955 0 0 0 4.953 1.318h.004c5.518 0 9.994-4.477 9.994-9.994C21.999 6.477 17.522 2 12.004 2Zm0 18.19a8.19 8.19 0 0 1-4.174-1.14l-.299-.178-3.09.849.826-3.024-.194-.31a8.184 8.184 0 0 1-1.253-4.393c0-4.526 3.68-8.207 8.19-8.207 2.19 0 4.248.853 5.796 2.402a8.14 8.14 0 0 1 2.398 5.805c0 4.527-3.68 8.196-8.2 8.196Z"/></svg>
              <span>WhatsApp</span>
            </a>
            <a href="tel:+380930582908" class="footer-contact-link" aria-label="Подзвонити">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              <span>+380 93 058 2908</span>
            </a>
            <a href="https://www.instagram.com/litopys.pro/" target="_blank" rel="noopener" class="footer-contact-link" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><path d="M17.5 6.5h.01"/></svg>
              <span>Instagram</span>
            </a>
            <a href="https://www.facebook.com/share/1MerdzfiWL/?mibextid=wwXIfr" target="_blank" rel="noopener" class="footer-contact-link" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
              <span>Facebook</span>
            </a>
            <a href="https://www.threads.com/@litopyspro" target="_blank" rel="noopener" class="footer-contact-link" aria-label="Threads">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.028-3.579.878-6.43 2.523-8.475C5.845 1.205 8.598.024 12.179 0h.014c2.746.018 5.043.725 6.826 2.101 1.677 1.293 2.85 3.13 3.487 5.46l-2.104.577c-1.045-3.821-3.652-5.792-7.756-5.859-2.898.02-5.09.906-6.516 2.634-1.331 1.615-2.017 3.945-2.04 6.928.023 2.983.709 5.313 2.04 6.928 1.426 1.728 3.618 2.614 6.516 2.634 2.622-.018 4.358-.643 5.804-2.089 1.645-1.645 1.614-3.66 1.088-4.878-.312-.727-.878-1.331-1.634-1.766-.192 1.363-.635 2.446-1.324 3.234-.913 1.045-2.19 1.62-3.796 1.71-1.221.068-2.395-.211-3.306-.786-1.079-.68-1.716-1.744-1.793-2.997-.075-1.221.39-2.35 1.31-3.18.883-.795 2.13-1.264 3.61-1.354a11.44 11.44 0 0 1 2.36.096c-.096-.579-.293-1.04-.588-1.373-.4-.451-1.021-.68-1.847-.685h-.024c-.665 0-1.573.184-2.15 1.06l-1.85-1.264c.78-1.18 2.115-1.83 3.976-1.83h.028c2.849.018 4.545 1.809 4.717 4.966.099.019.198.038.296.06 1.383.316 2.484 1.05 3.187 2.126.973 1.492 1.062 3.923-.916 5.9-1.837 1.836-4.06 2.663-7.212 2.686Zm.51-10.577c-.145 0-.291.004-.44.012-1.82.103-2.955.943-2.895 2.14.062 1.243 1.402 1.821 2.694 1.75 1.185-.066 2.05-.485 2.57-1.245.375-.55.616-1.301.72-2.244a9.61 9.61 0 0 0-2.649-.413Z"/></svg>
              <span>Threads</span>
            </a>
            <a href="https://www.tiktok.com/@litopyspro" target="_blank" rel="noopener" class="footer-contact-link" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82a4.28 4.28 0 0 1-3.03-3.71h-3.11v13.6a2.6 2.6 0 1 1-1.84-2.49V9.99a5.87 5.87 0 1 0 4.95 5.8V9.4a7.32 7.32 0 0 0 4.36 1.44V7.62a4.27 4.27 0 0 1-1.33-1.8Z"/></svg>
              <span>TikTok</span>
            </a>
          </div>
          <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
            <span>© {new Date().getFullYear()} Літопис. Усі права захищені.</span>
            <span>Зроблено в Україні.</span>
          </div>
        </div>
      </footer>
    )}

    <div id="cookie-banner" class="cookie-banner" hidden>
      <p class="cookie-banner-text">
        Ми використовуємо файли cookie: анонімний лічильник переглядів сайту та сесію входу в кабінет. Жодних рекламних трекерів.
      </p>
      <button type="button" id="cookie-banner-ok" class="cookie-banner-btn">Зрозуміло</button>
    </div>
  </body>
</html>

<style is:global>
  .nav-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--text);
    transition: background .15s;
    padding: 0;
    flex-shrink: 0;
  }
  .nav-icon-btn:hover { background: var(--bg-subtle); }
  .nav-icon-btn img { filter: brightness(0) saturate(100%); }

  .nav-download-wrap { position: relative; }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #fff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    min-width: 180px;
    z-index: 200;
    overflow: hidden;
    animation: ddFade .12s ease;
  }
  .nav-dropdown.open { display: block; }
  @keyframes ddFade { from { opacity:0; transform:translateY(-4px); } to { opacity:1; transform:none; } }

  .nav-dropdown-item {
    display: block;
    padding: .65rem 1rem;
    font-size: .875rem;
    font-weight: 500;
    color: var(--text);
    transition: background .12s;
    white-space: nowrap;
  }
  .nav-dropdown-item:hover { background: var(--bg-subtle); }
  .nav-dropdown-item + .nav-dropdown-item { border-top: 1px solid var(--border-subtle); }

  .footer-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
  }
  .footer-contact-link {
    display: flex;
    align-items: center;
    gap: .4rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color .15s;
  }
  .footer-contact-link:hover { color: var(--text); }
  .footer-contact-link svg { width: 16px; height: 16px; flex-shrink: 0; }

  .cookie-banner {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 300;
    max-width: 640px;
    margin: 0 auto;
    background: #1d1d1f;
    color: #fff;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    box-shadow: 0 12px 32px rgba(0,0,0,.2);
    animation: cookieFadeIn .3s ease;
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner-text {
    flex: 1 1 320px;
    font-size: .8125rem;
    line-height: 1.5;
    color: rgba(255,255,255,.85);
  }
  .cookie-banner-btn {
    flex-shrink: 0;
    background: #fff;
    color: #1d1d1f;
    border: none;
    border-radius: var(--radius-sm);
    padding: .55rem 1.25rem;
    font-size: .8125rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: opacity .15s;
  }
  .cookie-banner-btn:hover { opacity: .85; }
  @keyframes cookieFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  // Fetch latest GitHub release assets and wire up download links
  (async () => {
    const FALLBACK = 'https://github.com/litopysapp/litopys_release/releases/latest';
    try {
      const res = await fetch('https://api.github.com/repos/litopysapp/litopys_release/releases/latest', {
        headers: { 'Accept': 'application/vnd.github+json' }
      });
      if (res.ok) {
        const data = await res.json();
        const assets: { name: string; browser_download_url: string }[] = data.assets ?? [];
        const setup = assets.find((a: any) => a.name.includes('x64'))?.browser_download_url ?? FALLBACK;
        const portable = assets.find((a: any) => a.name.includes('Portable'))?.browser_download_url ?? FALLBACK;
        // nav dropdown
        const ns = document.getElementById('nav-dl-setup');
        const np = document.getElementById('nav-dl-portable');
        if (ns) ns.href = setup;
        if (np) np.href = portable;
        // hero dropdown (index page)
        const hs = document.getElementById('hero-dl-setup');
        const hp = document.getElementById('hero-dl-portable');
        if (hs) hs.href = setup;
        if (hp) hp.href = portable;
      }
    } catch {}
  })();

  const dlBtn = document.getElementById('dl-btn');
  const dlMenu = document.getElementById('dl-menu');
  if (dlBtn && dlMenu) {
    dlBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = dlMenu.classList.toggle('open');
      dlBtn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', () => {
      dlMenu.classList.remove('open');
      dlBtn.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dlMenu.classList.remove('open');
        dlBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  const COOKIE_NOTICE_KEY = 'litopys_cookie_notice_seen';
  const cookieBanner = document.getElementById('cookie-banner');
  const cookieBannerOk = document.getElementById('cookie-banner-ok');
  if (cookieBanner && !localStorage.getItem(COOKIE_NOTICE_KEY)) {
    cookieBanner.hidden = false;
  }
  cookieBannerOk?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_NOTICE_KEY, '1');
    if (cookieBanner) cookieBanner.hidden = true;
  });
</script>
