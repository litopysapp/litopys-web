---
// Сторінка юридичного тексту (умови, правила). Текст — з src/lib/legal-texts.ts.
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  html: string;
}
const { title, description, html } = Astro.props;
---
<Layout title={`${title} — Літопис`} description={description}>
  <section class="legal">
    <div class="legal-inner">
      <h1>{title}</h1>
      <article class="legal-text" set:html={html} />
    </div>
  </section>
</Layout>

<style>
  .legal { padding: 7rem 1.5rem 4rem; }
  .legal-inner { max-width: 760px; margin: 0 auto; }
  h1 { font-size: clamp(1.6rem, 3.4vw, 2.2rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.15; color: #111827; margin-bottom: 1.5rem; }
  .legal-text { font-size: .95rem; line-height: 1.65; color: #374151; overflow-wrap: anywhere; }
  .legal-text :global(p) { margin: 0 0 .75rem; }
  .legal-text :global(h3) { font-size: 1.1rem; font-weight: 700; color: #111827; margin: 2rem 0 .6rem; }
  .legal-text :global(ul), .legal-text :global(ol) { margin: 0 0 .75rem; padding-left: 1.4rem; }
  .legal-text :global(ul) { list-style: disc; }
  .legal-text :global(ol) { list-style: decimal; }
  .legal-text :global(li) { margin-bottom: .3rem; }
  .legal-text :global(code) { font-size: .85em; background: #f3f4f6; padding: .05em .3em; border-radius: 4px; }
</style>
