---
// Карусель партнерів для головної: картки зі списку src/lib/partners.ts
// і остання картка «Як стати партнером». Без бібліотек: прокрутка зі
// «зачепленням» карток + кнопки ‹ ›, які ховаються, коли гортати нікуди.
// Така сама карусель — на головній litograph.pro (site/build.js, partnersCarousel).
import { PARTNERS, markBg } from '../lib/partners';
---
<section class="pc" aria-labelledby="pc-title">
  <div class="pc-container">
    <div class="pc-head">
      <div>
        <p class="pc-eyebrow">Партнери</p>
        <h2 id="pc-title">Проєкти, яким ми довіряємо</h2>
      </div>
      <div class="pc-nav">
        <a class="pc-all" href="/partnery">Усі партнери <span style="color:var(--yellow)">→</span></a>
        <button type="button" class="pc-btn" data-dir="-1" aria-label="Попередні">‹</button>
        <button type="button" class="pc-btn" data-dir="1" aria-label="Наступні">›</button>
      </div>
    </div>
    <ul class="pc-track" role="list">
      {PARTNERS.map((p) => (
        <li class="pc-item">
          <a class="pc-card" href={p.url} target="_blank" rel="noopener">
            <span class="pc-mark" style={`background:${markBg(p)}`}><img src={p.icon} alt="" width="26" height="30" loading="lazy" /></span>
            <span class="pc-name">{p.name}</span>
            <span class="pc-domain">{p.domain}</span>
            <span class="pc-short">{p.short}</span>
            <span class="pc-go">Перейти на {p.domain} →</span>
          </a>
        </li>
      ))}
      <li class="pc-item">
        <a class="pc-card pc-join" href="/staty-partnerom">
          <span class="pc-mark pc-plus" aria-hidden="true">+</span>
          <span class="pc-name">Як стати партнером</span>
          <span class="pc-short">Розкажемо про ваш проєкт на litopys.pro і litograph.pro: картка, карусель на головній і плашка з вашим логотипом.</span>
          <span class="pc-go">Умови й контакти →</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .pc { padding: clamp(90px, 12vw, 160px) 0 0; }
  .pc-container { max-width: 1240px; margin: 0 auto; padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px)); }
  .pc-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 28px; }
  .pc-eyebrow { display: inline-flex; align-items: center; gap: 10px; font: 500 .74rem/1 var(--f-disp); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
  .pc-eyebrow::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--yellow); box-shadow: 0 0 14px var(--yellow); }
  .pc h2 { font: 700 clamp(2rem, 5vw, 4rem)/1.02 var(--f-disp); letter-spacing: -.035em; color: var(--text); }
  .pc-nav { display: flex; align-items: center; gap: .5rem; }
  .pc-all { font-size: .92rem; font-weight: 600; color: var(--text); margin-right: .5rem; }
  .pc-all::after { content: ""; }
  .pc-all:hover { color: var(--yellow); }
  .pc-btn { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line2); background: var(--glass); font-size: 1.3rem; line-height: 1; color: var(--text); cursor: pointer; transition: border-color .15s, opacity .15s; }
  .pc-btn:hover:not(:disabled) { border-color: var(--yellow); }
  .pc-btn:disabled { opacity: .3; cursor: default; }
  .pc-btn[hidden] { display: none; }
  .pc-track { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2 * 14px) / 3); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; padding: .25rem .1rem 1rem; margin: -.25rem -.1rem 0; }
  .pc-track::-webkit-scrollbar { display: none; }
  .pc-item { scroll-snap-align: start; display: flex; }
  .pc-card { display: flex; flex-direction: column; gap: .3rem; width: 100%; padding: 24px; border-radius: 22px; background: var(--glass); border: 1px solid var(--line); color: var(--text); transition: border-color .2s, transform .2s; }
  .pc-card:hover { border-color: var(--line2); transform: translateY(-3px); }
  .pc-mark { width: 50px; height: 50px; border-radius: 50%; display: grid; place-items: center; margin-bottom: .75rem; }
  .pc-mark img { width: 27px; height: auto; }
  .pc-name { font: 700 1.15rem/1.2 var(--f-disp); letter-spacing: -.02em; }
  .pc-domain { font-size: .85rem; font-weight: 600; color: var(--muted); }
  .pc-short { font-size: .95rem; color: var(--muted); line-height: 1.6; flex: 1; margin: .5rem 0 .9rem; }
  .pc-go { font-size: .92rem; font-weight: 600; }
  .pc-join { background: linear-gradient(140deg, rgba(244,199,22,.18), rgba(255,255,255,.03)); border-color: rgba(244,199,22,.4); }
  .pc-join:hover { border-color: var(--yellow); }
  .pc-plus { background: var(--yellow); color: #0b0c1d; font-size: 1.6rem; font-weight: 500; }
  .pc a:focus-visible, .pc-btn:focus-visible { outline: 2px solid var(--yellow); outline-offset: 3px; }
  @media (max-width: 900px) { .pc-track { grid-auto-columns: calc((100% - 14px) / 2); } }
  @media (max-width: 600px) { .pc-track { grid-auto-columns: 84%; } .pc-all { margin-right: 0; } }
  @media (prefers-reduced-motion: reduce) { .pc-track { scroll-behavior: auto; } .pc-card { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.pc').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pc-track');
    const btns = root.querySelectorAll<HTMLButtonElement>('.pc-btn');
    if (!track) return;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      btns.forEach((b) => {
        b.hidden = max <= 2;
        b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max - 2;
      });
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      const card = track.querySelector<HTMLElement>('.pc-item');
      const step = card ? card.offsetWidth + 20 : track.clientWidth;
      track.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
    }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
