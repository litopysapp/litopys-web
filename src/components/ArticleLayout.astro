---
// Оформлення статті: хлібні крихти, заголовок, текст (slot), підсумковий
// заклик і «Читайте також». Розмітка schema.org — Article + BreadcrumbList.
import Layout from '../layouts/Layout.astro';
import { ARTICLES, articleBySlug, formatDate } from '../lib/articles';

interface Props {
  slug: string;
  cta?: { eyebrow: string; title: string; text: string; href: string; button: string };
}
const { slug, cta } = Astro.props;
const meta = articleBySlug(slug)!;
const url = `https://litopys.pro/statti/${slug}`;
const related = ARTICLES.filter((a) => a.slug !== slug).slice(0, 3);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: meta.title,
    description: meta.description,
    datePublished: meta.date,
    dateModified: meta.date,
    inLanguage: 'uk',
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'Літопис', url: 'https://litopys.pro' },
    publisher: { '@type': 'Organization', name: 'Літопис', url: 'https://litopys.pro', logo: { '@type': 'ImageObject', url: 'https://litopys.pro/lito-badge.png' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Літопис', item: 'https://litopys.pro/' },
      { '@type': 'ListItem', position: 2, name: 'Статті', item: 'https://litopys.pro/statti' },
      { '@type': 'ListItem', position: 3, name: meta.title, item: url },
    ],
  },
];
---
<Layout title={`${meta.title} — Літопис`} description={meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="art-bg"></div>
  <article class="art">
    <nav class="crumbs" aria-label="Навігація">
      <a href="/">Головна</a><span>›</span><a href="/statti">Статті</a>
    </nav>
    <p class="art-tag">{meta.tag} · <time datetime={meta.date}>{formatDate(meta.date)}</time></p>
    <h1>{meta.title}</h1>
    <p class="art-lead">{meta.description}</p>
    <div class="prose">
      <slot />
    </div>

    {cta && (
      <div class="art-cta">
        <p class="cta-eyebrow">{cta.eyebrow}</p>
        <h2>{cta.title}</h2>
        <p>{cta.text}</p>
        <a href={cta.href} class="cta-btn">{cta.button}</a>
      </div>
    )}

    <aside class="related">
      <h2>Читайте також</h2>
      <div class="related-grid">
        <a href="/rukopysnyi-tekst-onlain" class="rel">
          <span class="rel-tag">Безкоштовно</span>
          <b>Рукописний текст онлайн</b>
          <span>Перетворіть текст на сторінку, написану від руки, і завантажте PNG або PDF.</span>
        </a>
        {related.map((a) => (
          <a href={`/statti/${a.slug}`} class="rel">
            <span class="rel-tag">{a.tag}</span>
            <b>{a.title}</b>
            <span>{a.description}</span>
          </a>
        ))}
      </div>
    </aside>
  </article>
</Layout>

<style>
  .art-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse at 15% 20%, #f1e4f6 0%, transparent 50%), #fbfbfd;
  }
  .art { max-width: 760px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
  .crumbs { display: flex; gap: .5rem; font-size: .8125rem; color: #6b7280; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .crumbs a:hover { color: #7c3a8a; }
  .art-tag { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #7c3a8a; margin-bottom: .75rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -.035em; line-height: 1.15; color: #111827; margin-bottom: 1rem; }
  .art-lead { font-size: 1.125rem; color: #4b5563; line-height: 1.7; margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #e5e7eb; }

  .prose { color: #374151; font-size: 1.0625rem; line-height: 1.8; }
  .prose :global(h2) { font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; color: #111827; margin: 2.5rem 0 .9rem; line-height: 1.3; }
  .prose :global(h3) { font-size: 1.15rem; font-weight: 700; color: #111827; margin: 1.75rem 0 .6rem; }
  .prose :global(p) { margin-bottom: 1.1rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem 1.4rem; display: flex; flex-direction: column; gap: .45rem; }
  .prose :global(a) { color: #7c3a8a; text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(b), .prose :global(strong) { color: #111827; }
  .prose :global(.tip) { background: #f5ebf7; border-left: 4px solid #7c3a8a; border-radius: 0 12px 12px 0; padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .prose :global(.tip p:last-child) { margin-bottom: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1rem 0 1.5rem; font-size: .95rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid #e5e7eb; padding: .6rem .75rem; text-align: left; vertical-align: top; }
  .prose :global(th) { color: #111827; font-weight: 700; background: #f9fafb; }

  .art-cta {
    margin: 3rem 0; border-radius: 24px; padding: 2.5rem 2rem; color: #fff; text-align: center;
    background: linear-gradient(135deg, #3d1345 0%, #7c3a8a 65%, #9c4fae 100%);
    box-shadow: 0 18px 48px rgba(61,19,69,.25);
  }
  .cta-eyebrow { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.65); margin-bottom: .6rem; }
  .art-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; letter-spacing: -.03em; margin-bottom: .75rem; }
  .art-cta p { color: rgba(255,255,255,.8); line-height: 1.65; margin-bottom: 1.5rem; }
  .cta-btn { display: inline-block; background: #fff; color: #7c3a8a; padding: .8rem 2rem; border-radius: 50px; font-weight: 700; transition: transform .2s; }
  .cta-btn:hover { transform: translateY(-2px); }

  .related h2 { font-size: 1.25rem; font-weight: 800; color: #111827; margin-bottom: 1rem; }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .rel { display: flex; flex-direction: column; gap: .35rem; background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.1rem 1.25rem; transition: border-color .2s, box-shadow .2s; }
  .rel:hover { border-color: #dcb8e5; box-shadow: 0 8px 24px rgba(0,0,0,.06); }
  .rel b { color: #111827; line-height: 1.35; }
  .rel span:last-child { color: #6b7280; font-size: .875rem; line-height: 1.55; }
  .rel-tag { font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #7c3a8a; }

  @media (max-width: 640px) {
    .art { padding: 2rem 1rem 4rem; }
    .related-grid { grid-template-columns: 1fr; }
    .art-cta { padding: 2rem 1.25rem; }
  }
</style>
